string G_FUNNEL = "10 - Entry Funnel Diagnostics"

showFunnelInput =
     input.bool(
         false, "Show Entry Funnel Diagnostics Table",
         tooltip = "Debug table. Off by default.",
         group = G_FUNNEL
     )

funnelTablePositionInput =
     input.string(
         "Bottom Left",
         "Funnel Table Position",
         options = [
             "Top Left", "Top Center", "Top Right",
             "Middle Left", "Middle Center", "Middle Right",
             "Bottom Left", "Bottom Center", "Bottom Right"
         ],
         group = G_FUNNEL
     )

funnelTableSizeInput =
     input.string(
         "Tiny",
         "Funnel Table Text Size",
         options = ["Tiny", "Small", "Normal", "Large"],
         group = G_FUNNEL
     )

var array<int> fLong = array.new_int(8, 0)
var array<int> fShort = array.new_int(8, 0)

f_incrFunnel(
     array<int> counts,
     bool structureOk,
     bool signalOk,
     bool momentumOk,
     bool pressureOk,
     bool sessionOk,
     bool cooldownOk,
     bool riskOk
) =>
    array.set(counts, 0, array.get(counts, 0) + 1)

    if structureOk
        array.set(counts, 1, array.get(counts, 1) + 1)

        if signalOk
            array.set(counts, 2, array.get(counts, 2) + 1)

            if momentumOk
                array.set(counts, 3, array.get(counts, 3) + 1)

                if pressureOk
                    array.set(counts, 4, array.get(counts, 4) + 1)

                    if sessionOk
                        array.set(counts, 5, array.get(counts, 5) + 1)

                        if cooldownOk
                            array.set(counts, 6, array.get(counts, 6) + 1)

                            if riskOk
                                array.set(counts, 7, array.get(counts, 7) + 1)

    true

if barstate.isconfirmed
    f_incrFunnel(
         fLong,
         longStructureOk,
         longSignalNow,
         momentumOkLong,
         pressureOkLong,
         sessionOkForLong,
         longCooldownOk,
         longRiskOk
    )

    f_incrFunnel(
         fShort,
         shortStructureOk,
         shortSignalNow,
         momentumOkShort,
         pressureOkShort,
         sessionOkForShort,
         shortCooldownOk,
         shortRiskOk
    )

var table funnelTable =
     table.new(
         f_tablePosition(funnelTablePositionInput),
         3, 9,
         bgcolor = color.new(color.rgb(15, 20, 27), 10),
         border_width = 1
     )

if barstate.islast and showFunnelInput
    funnelTextSize = f_tableTextSize(funnelTableSizeInput)

    array<string> funnelLabels =
         array.from(
             "ENTRY FUNNEL",
             "Bars Evaluated",
             "+ Structure",
             "+ Signal",
             "+ Momentum",
             "+ Pressure",
             "+ Session",
             "+ Cooldown",
             "+ Risk OK"
         )

    for row = 0 to 8
        table.cell(
             funnelTable,
             0, row,
             array.get(funnelLabels, row),
             text_color = color.white,
             bgcolor = row == 0 ? color.rgb(22, 52, 86) : na,
             text_size = funnelTextSize
        )

    table.cell(funnelTable, 1, 0, "LONG",
         text_color = longColorInput, bgcolor = color.rgb(22, 52, 86), text_size = funnelTextSize)

    table.cell(funnelTable, 2, 0, "SHORT",
         text_color = shortColorInput, bgcolor = color.rgb(22, 52, 86), text_size = funnelTextSize)

    for row = 1 to 8
        table.cell(funnelTable, 1, row, str.tostring(array.get(fLong, row - 1)),
             text_color = color.gray, text_size = funnelTextSize)

        table.cell(funnelTable, 2, row, str.tostring(array.get(fShort, row - 1)),
             text_color = color.gray, text_size = funnelTextSize)


