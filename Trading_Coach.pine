    table.cell(coachTable, 0, 0, "TRADING COACH",
         text_color = color.white, bgcolor = color.rgb(22, 52, 86), text_size = dashTextSize)

    table.cell(coachTable, 1, 0, syminfo.ticker + " " + timeframe.period,
         text_color = color.white, bgcolor = color.rgb(22, 52, 86), text_size = dashTextSize)

    table.cell(coachTable, 0, 1, "Coach Observation",
         text_color = color.yellow, text_size = dashTextSize)

    table.cell(coachTable, 1, 1, coachMessage,
