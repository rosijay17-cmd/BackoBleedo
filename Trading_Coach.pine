string coachResRefText =
     na(selectedResistanceLevel) ?
     "no valid resistance" :
     str.tostring(selectedResistanceLevel, format.mintick) +
     " " + selectedResistanceSource

string coachSupRefText =
     na(selectedSupportLevel) ?
     "no valid support" :
     str.tostring(selectedSupportLevel, format.mintick) +
     " " + selectedSupportSource

string coachMessage =
     structureTrend == "RANGE" ?
     "Structure ranging -- wait for clearer structure" :

     structureTrend == "UP" and not longSignalNow ?
     "Uptrend -- RES " + coachResRefText + " | " + resAction :

     structureTrend == "UP" and longSignalNow and not momentumOkLong ?
     "S/R break fired -- waiting for momentum confirmation" :

     structureTrend == "UP" and longSignalNow and momentumOkLong and not pressureOkLong ?
     "Momentum confirms -- waiting for volume pressure" :

     structureTrend == "UP" and longSignalNow and momentumOkLong and pressureOkLong and not sessionOkForLong ?
     "Setup ready -- outside favorable session" :

     structureTrend == "UP" and longSignalNow and momentumOkLong and pressureOkLong and sessionOkForLong and not longCooldownOk ?
     "Setup ready -- long cooldown active" :

     actualLongSignal ?
     "LONG SETUP ACTIVE [Grade " + longSetupGrade + "]" :

     structureTrend == "DOWN" and not shortSignalNow ?
     "Downtrend -- SUP " + coachSupRefText + " | " + supAction :

     structureTrend == "DOWN" and shortSignalNow and not momentumOkShort ?
     "S/R break fired -- waiting for momentum confirmation" :

     structureTrend == "DOWN" and shortSignalNow and momentumOkShort and not pressureOkShort ?
     "Momentum confirms -- waiting for volume pressure" :

     structureTrend == "DOWN" and shortSignalNow and momentumOkShort and pressureOkShort and not sessionOkForShort ?
     "Setup ready -- outside favorable session" :

     structureTrend == "DOWN" and shortSignalNow and momentumOkShort and pressureOkShort and sessionOkForShort and not shortCooldownOk ?
     "Setup ready -- short cooldown active" :

     actualShortSignal ?
     "SHORT SETUP ACTIVE [Grade " + shortSetupGrade + "]" :

     "No clear setup forming"

var table coachTable =
     table.new(
         f_tablePosition(dashboardPositionInput),
         2, 12,
         bgcolor = color.new(color.rgb(15, 20, 27), 10),
         border_width = 1
     )

if barstate.islast and showDashboardInput
