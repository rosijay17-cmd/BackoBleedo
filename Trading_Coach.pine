              tdiConfirmsShort ? shortColorInput : color.gray,
         text_size = dashTextSize)

    table.cell(coachTable, 0, 6, "Zone Broken",
         text_color = color.white, text_size = dashTextSize)

    table.cell(coachTable, 1, 6, str.tostring(zonesBrokenCount) + " / 6",
         text_color = zonesBrokenCount > 0 ? color.orange : color.gray,
         text_size = dashTextSize)

    string dashRes =
         na(selectedResistanceLevel) ?
