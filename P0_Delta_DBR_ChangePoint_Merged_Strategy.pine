float anchorAdaptMaxInput = input.float(1.15, "Anchor Adaptive Max Scale", minval = 1.0, maxval = 1.5, step = 0.05, group = G_ENTRY)
bool useStructuralFilterInput = input.bool(true, "Block Entries Through Structural Resistance/Support", group = G_ENTRY)
bool useStructuralTargetInput = input.bool(true, "Cap Target At Nearest Structural Level", group = G_ENTRY)
bool requireFreshState = input.bool(true, "Require Fresh Anchor Flip State", group = G_ENTRY)
int cooldownBarsLongInput = input.int(20, "Cooldown After Long Exit", minval = 0, maxval = 50, group = G_ENTRY)
int cooldownBarsShortInput = input.int(20, "Cooldown After Short Exit", minval = 0, maxval = 50, group = G_ENTRY)


//=============================================================================
// 05 — Risk (Anchor)
//=============================================================================

string G_RISK = "05 — Risk (Anchor)"

float contracts = input.float(1.0, "Contracts", minval = 1.0, step = 1.0, group = G_RISK)
float stopATR = input.float(1.0, "Initial Stop (ATR)", minval = 0.25, maxval = 5.0, step = 0.05, group = G_RISK)
float targetRR = input.float(1.75, "Target (R)", minval = 0.50, maxval = 5.0, step = 0.05, group = G_RISK)
bool useBreakEven = input.bool(false, "Move Stop To Break-Even", group = G_RISK)
float breakEvenAtR = input.float(1.0, "Break-Even Trigger (R)", minval = 0.25, maxval = 3.0, step = 0.25, group = G_RISK)


//=============================================================================
// 06 — P0 / Key Levels
//=============================================================================

string G_STYLE = "06 — P0 / Key Levels"

bool showDynamicP0 = input.bool(true, "Show Dynamic P0", group = G_STYLE)
bool showDynamicP0LabelInput = input.bool(true, "Label The Dynamic P0 Line", group = G_STYLE)
color dynamicP0Color = input.color(color.aqua, "Dynamic P0 Color", group = G_STYLE)
int dynamicP0Width = input.int(3, "Dynamic P0 Width", minval = 1, maxval = 5, group = G_STYLE)
bool showDynamicValueArea = input.bool(true, "Show Dynamic VAH / VAL", group = G_STYLE)
color dynamicValueAreaColor = input.color(color.rgb(70, 115, 255), "Dynamic Value Area Color", group = G_STYLE)
bool showStructuralPOC = input.bool(true, "Show Structural POC", group = G_STYLE)
color structuralPOCColor = input.color(color.rgb(229, 57, 53), "Structural POC Color", group = G_STYLE)
bool showStructuralValueArea = input.bool(true, "Show Structural VAH / VAL", group = G_STYLE)
color structuralValueAreaColor = input.color(color.rgb(70, 115, 255), "Structural Value Area Color", group = G_STYLE)
