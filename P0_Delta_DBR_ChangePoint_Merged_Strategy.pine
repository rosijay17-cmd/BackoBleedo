//=============================================================================
// 14 — DBR Signal Visuals
//=============================================================================

string G_SIG = "14 — DBR Signal Visuals"

bool showChangePointVisualInput = input.bool(true, "Show CUSUM Regime Line + Pressure Fill", group = G_SIG)
bool showRetestTouchMarkerInput = input.bool(true, "Show Retest Touch Marker", group = G_SIG)
bool showEntrySignalInput = input.bool(true, "Show Actual Entry Signal", group = G_SIG)
