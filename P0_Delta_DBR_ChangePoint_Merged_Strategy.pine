// 04 — Entry Engine (Anchor Trail Proxy)
//=============================================================================

string G_ENTRY = "04 — Entry Engine (Anchor Trail Proxy)"

int anchorAtrLenInput = input.int(14, "Anchor ATR Length", minval = 1, group = G_ENTRY)
anchorSrcInput = input.source(close, "Anchor Source", group = G_ENTRY)
float anchorBandMultInput = input.float(6.5, "Anchor Band Offset (Base)", minval = 1.0, maxval = 20.0, step = 0.1, group = G_ENTRY)
bool anchorUseAdaptiveInput = input.bool(true, "Anchor Adaptive Band Scaling", group = G_ENTRY)
