string G_DASH = "07 — Architecture Histogram"

bool showArchitectureHistogram = input.bool(true, "Show Acceptance / Rejection Histogram", group = G_DASH)
string architecturePosition = input.string("Top Right", "Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = G_DASH)
string dashboardTextSize = input.string("Small", "Dashboard Text Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = G_DASH)
