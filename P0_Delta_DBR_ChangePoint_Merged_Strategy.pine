//@version=6
strategy(
     title = "Dynamic P0 Delta + DBR Change-Point Merged Strategy",
     shorttitle = "P0 Delta + DBR CP",
     overlay = true,
     initial_capital = 100000,
     pyramiding = 2,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 2.50,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_order_fills = true,
     calc_on_every_tick = true,
     use_bar_magnifier = false,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500,
     margin_long = 3,
     margin_short = 3
)

//=============================================================================
// MERGED STRATEGY -- READ FIRST
//-----------------------------------------------------------------------------
// This file merges two previously separate strategies into one script, per
// explicit request:
//   1. Dynamic P0 Delta Profile Strategy v1.0.4 (Anchor Trail Proxy entries,
//      Structural Profile / Dynamic P0 / Acceptance-Rejection scoring,
//      "Architecture Histogram" dashboard table).
//   2. Delta Break & Retest - Stage 9 Change Point + Volume Pressure &
//      DeltaFlow VP (CUSUM change-point/retest entries, 4H/1H MTF filters,
//      DeltaFlow Volume Profile [BigBeluga] histogram).
//
// KEPT FROM EACH, PER REQUEST:
//   - DeltaFlow Volume Profile [BigBeluga] histogram (from script 2) is the
//     ONLY histogram in this file. Script 1's own right-side "Structural
//     Histogram" (its box-based delta-by-price bars) was dropped since it
//     served the same visual role -- its underlying computation (POC, VAH/
//     VAL, Delta Support/Resistance lines, Liquidity Zones) is NOT part of
//     that histogram and is kept, since the Anchor entry engine's structural
//     filter/target logic depends on it.
//   - The "Architecture Histogram" dashboard table (from script 1) is the
//     ONLY dashboard table in this file. Script 2's own Status + Change-
//     Point Funnel tables were dropped as separate table objects, but their
//     information is not lost -- summarized as 7 extra rows appended to the
//     Architecture table (toggle: "Show DBR Change-Point Status Rows In
//     Dashboard", section 07). The Funnel's full per-gate fail-count
//     breakdown is still available via Data Window plots, same as this
//     script's existing diagnostic pattern.
//   - Everything else from both scripts -- both full entry engines, all
//     scoring/filter machinery, all MTF context, cooldown/risk logic --
//     is kept and computed, exactly as each original script did it.
//
// ENTRY INDEPENDENCE:
// Requested: entries from the Anchor Trail Flip engine and the Change-Point
// Retest engine must work independently of one another. This is implemented
// as fully as TradingView's strategy() model allows:
//   - Separate decision-making: neither engine's cooldown, armed-state, or
//     fresh-signal gate reads anything from the other engine. Each has its
//     own "in trade" flag (anchorFlat / dbrInTrade) derived from its OWN
//     entry ids, NOT from strategy.position_size, specifically so one
//     engine's open trade can never make the other think it's flat (or vice
//     versa) just because the NET account position happens to net out.
//   - Separate order/bracket management: each engine uses its own unique
//     entry ids ("Anchor Long"/"Anchor Short" vs "CP Long"/"CP Short") and
//     manages its own stop/target purely through its own from_entry id, so
//     one engine's exit can never touch the other's bracket.
//   - Each engine's closed-trade detection walks strategy.closedtrades with
//     its own cursor and filters by its own entry ids, so a same-bar close
//     from the OTHER engine is correctly skipped rather than mis-read.
//   - pyramiding is raised from each original script's own value (0) to 2,
//     so one entry from EACH engine can be open at the same time without
//     either order being rejected for exceeding the position-count limit.
//
// PLATFORM LIMIT THIS CANNOT WORK AROUND: TradingView's strategy() broker
// emulator only ever tracks a SINGLE NET position per script -- there is no
// hedging mode. If both engines want the SAME direction at once, both can
// hold (that's what the pyramiding=2 change is for). If they want OPPOSITE
// directions at once, the second order will net against/reduce/flip the
// first engine's open quantity, exactly like any other opposite-direction
// order would on a real single, non-hedged account -- no Pine code can make
// one script hold a simultaneous hedged long AND short. Each engine's own
// decision-making, cooldown, and bracket management remain fully
// independent regardless; only the shared account's NET fill quantity is
// unavoidably shared.
//
// Pine does not expose native bid/ask aggressor volume here. Delta (in both
// engines) is estimated from OHLCV candle pressure.
//=============================================================================


//=============================================================================
// 00 — Master Visibility
//=============================================================================

string G_MASTER = "00 — Master Visibility"

bool showAllChartObjectsInput = input.bool(true, "Show All Chart Objects", tooltip = "Master switch for everything this script draws ON THE CHART PANE -- plots, labels, lines, boxes, setup/entry markers, bar coloring, the DeltaFlow histogram, and the Architecture dashboard table. Uncheck to hide all of it at once instead of unticking every individual 'Show ...' toggle below. Does NOT affect the diagnostic plots under Data Window at the bottom of this script -- those never draw on the chart itself.", group = G_MASTER)


//=============================================================================
// 01 — Structural Profile (Anchor / P0 Delta engine)
//=============================================================================

string G_STRUCT = "01 — Structural Profile"

int structuralDays = input.int(120, "Lookback Days", minval = 1, maxval = 120, group = G_STRUCT)
int structuralRows = input.int(80, "Histogram / Profile Price Bars", minval = 20, maxval = 160, step = 10, tooltip = "Controls the number of actual price bins used by the structural delta profile. Higher values provide finer POC, VAH/VAL, delta-node, support/resistance, and liquidity-zone resolution. Higher values also require more processing.", group = G_STRUCT)
int maxStoredBars = input.int(25000, "Maximum Stored Chart Bars", minval = 1000, maxval = 50000, step = 1000, group = G_STRUCT)
float structuralValueArea = input.float(70.0, "Value Area %", minval = 50.0, maxval = 95.0, step = 1.0, group = G_STRUCT)
float minNodeVolume = input.float(25.0, "Minimum Node Volume (% Of POC)", minval = 0.0, maxval = 100.0, step = 5.0, group = G_STRUCT)
float minNodeDelta = input.float(10.0, "Minimum Absolute Delta %", minval = 0.0, maxval = 100.0, step = 1.0, group = G_STRUCT)
int liquidityNodeCount = input.int(4, "High-Delta Liquidity Zones", minval = 1, maxval = 8, group = G_STRUCT)


//=============================================================================
// 02 — Dynamic P0
//=============================================================================

string G_P0 = "02 — Dynamic P0"

int equilibriumMinutes = input.int(240, "Equilibrium Window (Minutes)", minval = 60, maxval = 1440, step = 30, group = G_P0)
int equilibriumRows = input.int(32, "Dynamic P0 Price Rows", minval = 16, maxval = 64, group = G_P0)
int maximumEquilibriumBars = input.int(500, "Maximum Bars In Dynamic Profile", minval = 50, maxval = 1000, group = G_P0)
float dynamicValueAreaPercent = input.float(70.0, "Dynamic Value Area %", minval = 50.0, maxval = 95.0, step = 1.0, group = G_P0)
int coherenceRadius = input.int(2, "P0 Coherence Radius (Rows)", minval = 1, maxval = 5, group = G_P0)
float equilibriumBandATR = input.float(0.35, "Equilibrium Band (ATR)", minval = 0.10, maxval = 1.0, step = 0.05, group = G_P0)
float minimumDistanceATR = input.float(0.80, "Minimum Entry Distance From P0 (ATR)", minval = 0.25, maxval = 3.0, step = 0.05, group = G_P0)


//=============================================================================
// 03 — Acceptance / Rejection Metrics
//=============================================================================

string G_METRICS = "03 — Acceptance / Rejection Metrics"

int migrationLookback = input.int(4, "P0 / Value Migration Lookback", minval = 1, maxval = 20, group = G_METRICS)
float migrationTargetATR = input.float(0.15, "Strong P0 Migration (ATR)", minval = 0.02, maxval = 1.0, step = 0.01, group = G_METRICS)
float catchUpTargetPercent = input.float(40.0, "Strong P0 Catch-Up %", minval = 10.0, maxval = 100.0, step = 5.0, group = G_METRICS)
float newLocationBandATR = input.float(0.25, "New-Location Volume Band (ATR)", minval = 0.10, maxval = 1.0, step = 0.05, group = G_METRICS)
float newLocationTargetPercent = input.float(35.0, "Strong New-Location Volume %", minval = 10.0, maxval = 80.0, step = 5.0, group = G_METRICS)
int newLocationRecentBars = input.int(20, "New-Location Recency Window (Bars)", minval = 3, maxval = 100, tooltip = "New-Location Volume only counts volume from the most recent N bars, not the entire multi-hour rolling profile -- measures whether volume is NEWLY piling in at the current price right now.", group = G_METRICS)
float valueMigrationTargetATR = input.float(0.10, "Strong Value-Area Migration (ATR)", minval = 0.02, maxval = 1.0, step = 0.01, group = G_METRICS)
int deltaWindow = input.int(3, "Delta State Window", minval = 1, maxval = 10, group = G_METRICS)
int deltaPersistenceBars = input.int(3, "Delta Persistence Bars", minval = 2, maxval = 8, group = G_METRICS)
float alignedDeltaTarget = input.float(20.0, "Strong Aligned Delta %", minval = 5.0, maxval = 80.0, step = 1.0, group = G_METRICS)
float opposingDeltaTarget = input.float(20.0, "Strong Opposing Delta %", minval = 5.0, maxval = 80.0, step = 1.0, group = G_METRICS)
int efficiencyLookback = input.int(3, "Efficiency Lookback", minval = 1, maxval = 10, group = G_METRICS)
float efficiencyTargetATR = input.float(0.30, "Efficient Price Progress (ATR)", minval = 0.05, maxval = 1.50, step = 0.05, group = G_METRICS)
float absorptionDeltaTarget = input.float(25.0, "Absorption Delta Magnitude %", minval = 5.0, maxval = 100.0, step = 1.0, group = G_METRICS)
float absorptionMaximumProgressATR = input.float(0.12, "Absorption Maximum Price Progress (ATR)", minval = 0.02, maxval = 0.50, step = 0.01, group = G_METRICS)
int dwellMeasurementBars = input.int(4, "Dwell Measurement Bars", minval = 2, maxval = 12, group = G_METRICS)
float minimumCoherence = input.float(55.0, "Minimum Profile Coherence", minval = 0.0, maxval = 100.0, step = 1.0, group = G_METRICS)

// The four inputs below no longer gate any entry (the anchor trail-flip
// proxy in section 04 does that) -- they only tune when the dashboard's
// ACCEPT/REJECT/READ columns and marketState read "dominant" for display.

float acceptanceThresholdLong = input.float(65.0, "Acceptance Score Threshold (Long, Informational)", minval = 40.0, maxval = 95.0, step = 1.0, group = G_METRICS)
float acceptanceThresholdShort = input.float(65.0, "Acceptance Score Threshold (Short, Informational)", minval = 40.0, maxval = 95.0, step = 1.0, group = G_METRICS)
float rejectionThresholdLong = input.float(50.0, "Rejection Score Threshold (Long, Informational)", minval = 40.0, maxval = 95.0, step = 1.0, group = G_METRICS)
float rejectionThresholdShort = input.float(50.0, "Rejection Score Threshold (Short, Informational)", minval = 40.0, maxval = 95.0, step = 1.0, group = G_METRICS)
float scoreDominanceLong = input.float(24.0, "Required Score Dominance (Long, Informational)", minval = 0.0, maxval = 40.0, step = 1.0, group = G_METRICS)
float scoreDominanceShort = input.float(24.0, "Required Score Dominance (Short, Informational)", minval = 0.0, maxval = 40.0, step = 1.0, group = G_METRICS)
float signalStabilityMargin = input.float(0.0, "Signal Stability Margin (Informational)", minval = 0.0, maxval = 20.0, step = 0.5, group = G_METRICS)


