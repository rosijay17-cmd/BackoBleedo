//@version=6
strategy(
     title="Sweep Trend Continuation + SVP — Clean Overlay",
     shorttitle="SweepTrend+SVP",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=true,
     calc_on_order_fills=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     slippage=1,
     max_labels_count=200,
     max_lines_count=100,
     max_boxes_count=100)

// ═══════════════════════════════════════════════════════════════════
// INPUT GROUPS
// ═══════════════════════════════════════════════════════════════════

const string GRP_TREND   = "01 — Trend Filter"
const string GRP_MOM     = "02 — Momentum Filter"
const string GRP_SWEEP   = "03 — Liquidity Sweep Entry"
const string GRP_FREQ    = "04 — Trade Frequency"
const string GRP_SESSION = "05 — Trading Session"
const string GRP_SIZE    = "06 — Position Sizing"
const string GRP_RISK    = "07 — Risk Management"
const string GRP_TRAIL   = "08 — Trailing Stop"
const string GRP_VISUAL  = "09 — Visuals"
const string GRP_ALERTS  = "10 — Alerts"
const string GRP_PROFILE = "11 — Session Volume Profile"
const string GRP_HTF2    = "12 — Daily HTF Bias"
const string GRP_MAXVOL  = "13 — Max Volume Price"
const string GRP_ATRREF  = "14 — ATR(21) Reference"
const string GRP_SESSVOL = "15 — Session Volume Delta"

// ═══════════════════════════════════════════════════════════════════
// TREND FILTER
// ═══════════════════════════════════════════════════════════════════

int trendFastLen = input.int(
     20,
     "Fast EMA Length",
     minval=2,
     group=GRP_TREND)

int trendSlowLen = input.int(
     50,
     "Slow EMA Length",
     minval=3,
     group=GRP_TREND)

int adxLen = input.int(
     14,
     "ADX Length",
     minval=2,
     group=GRP_TREND)

float adxMin = input.float(
     15.0,
     "Minimum ADX",
     minval=1.0,
     step=0.5,
     tooltip="Lowered from 20 -- at 20+ this alone was screening out a large share of otherwise-valid sweep setups on chop-adjacent trends. 15 still filters genuinely flat markets without demanding a strong trend on top of everything else this strategy already requires.",
     group=GRP_TREND)

bool requireDIAlignment = input.bool(
     true,
     "Require +DI / -DI Alignment",
     group=GRP_TREND)

bool useHtfTrendFilter = input.bool(
     true,
     "Use Confirmed Higher-Timeframe Filter",
     group=GRP_TREND)

string htfTimeframe = input.timeframe(
     "60",
     "Higher Timeframe",
     group=GRP_TREND)

int htfFastLen = input.int(
     20,
     "HTF Fast EMA Length",
     minval=2,
     group=GRP_TREND)

int htfSlowLen = input.int(
     50,
     "HTF Slow EMA Length",
     minval=3,
     group=GRP_TREND)

// ═══════════════════════════════════════════════════════════════════
// MOMENTUM FILTER
// ═══════════════════════════════════════════════════════════════════

bool requireMomentumAgreement = input.bool(
     true,
     "Require ROC / BOP Momentum Agreement",
     tooltip="ROC and BOP must agree with the sweep direction.",
     group=GRP_MOM)

int rocLen = input.int(
     14,
     "ROC Length",
     minval=2,
     group=GRP_MOM)

float rocMinAbs = input.float(
     0.05,
     "Minimum |ROC| To Qualify",
     minval=0.0,
     step=0.05,
     tooltip="Lowered from 0.10 -- ROC(14) rarely holds above 0.10 for more than a few bars on most symbols/timeframes, so this alone was blocking momentum agreement on plenty of otherwise-clean sweeps. 0.05 still requires a real directional move, not noise.",
     group=GRP_MOM)

int bopLen = input.int(
     21,
     "BOP Smoothing Length",
     minval=2,
     group=GRP_MOM)

// ═══════════════════════════════════════════════════════════════════
// LIQUIDITY SWEEP
// ═══════════════════════════════════════════════════════════════════

int atrLen = input.int(
     14,
     "ATR Length",
     minval=2,
     group=GRP_SWEEP)

int sweepPivotLength = input.int(
     5,
     "Swing Pivot Length",
     minval=1,
     group=GRP_SWEEP)

int sweepStoredLevels = input.int(
     20,
     "Stored Liquidity Levels",
     minval=5,
     maxval=100,
     group=GRP_SWEEP)

float sweepMinDistanceAtr = input.float(
     0.10,
     "Minimum Sweep Distance / ATR",
     minval=0.01,
     step=0.01,
     group=GRP_SWEEP)

string sweepReclaimRule = input.string(
     "Close Back Inside",
     "Reclaim Rule",
     options=[
         "Close Back Inside",
         "Strong Reclaim"
     ],
     group=GRP_SWEEP)

float sweepMinWickPercent = input.float(
     0.25,
     "Minimum Wick %",
     minval=0.0,
     maxval=1.0,
     step=0.01,
     tooltip="Lowered from 0.35 -- a valid sweep-and-reclaim wick doesn't need to dominate the candle to be real; 0.35 was rejecting reclaim candles with a genuine, if more modest, rejection wick.",
     group=GRP_SWEEP)

float sweepMaxBodyPercent = input.float(
     0.75,
     "Maximum Body %",
     minval=0.05,
     maxval=1.0,
     step=0.01,
     tooltip="Raised from 0.65 -- paired with the lower wick minimum above so the two thresholds don't fight each other (a candle can now have up to a 75% body AND still qualify on a 25%+ wick, whereas before both had to land in a narrower band simultaneously).",
     group=GRP_SWEEP)

float sweepMinRangeAtr = input.float(
     0.20,
     "Minimum Candle Range / ATR",
     minval=0.01,
     step=0.01,
     group=GRP_SWEEP)

bool sweepRequireBullishBody = input.bool(
     true,
     "Long Confirmation Must Be Bullish",
     group=GRP_SWEEP)

bool sweepRequireBearishBody = input.bool(
     true,
     "Short Confirmation Must Be Bearish",
     group=GRP_SWEEP)

int sweepConfirmationWindow = input.int(
     4,
     "Max Bars After Sweep For Confirmation",
     minval=0,
     maxval=10,
     tooltip="Raised from 2 -- a real reclaim doesn't always land on the very next bar or two; this gives the market a few more bars to actually produce the confirmation candle before the sweep is discarded.",
     group=GRP_SWEEP)

bool sweepRequireMidlineBreak = input.bool(
     true,
     "Require Sweep Candle Midline Break",
     group=GRP_SWEEP)

int sweepSignalSpacingBars = input.int(
     5,
     "Minimum Bars Between Sweep Signals",
     minval=0,
     tooltip="Lowered from 10 -- this was a hard floor on how often ANY signal could fire in a direction, independent of whether the market set up a genuinely new, valid sweep. 5 still prevents rapid-fire re-signaling off the same level.",
     group=GRP_SWEEP)

// ═══════════════════════════════════════════════════════════════════
