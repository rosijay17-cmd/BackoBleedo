//@version=6
indicator("Advanced Session Profile Predictor with SR Boxes & OR", overlay=true, max_boxes_count=50)

// ============================================================================
// ADVANCED SESSION PROFILE PREDICTOR WITH SR BOXES & OR -- IMPROVED
// ----------------------------------------------------------------------------
// Started as a byte-for-byte-behavior code cleanup (renamed identifiers,
// English comments, no logic/UI changes). Six real findings from that pass
// are now APPLIED here on top, each changing something observable -- listed
// so it's clear what's different from the original script, not just from
// the earlier "parity" pass:
//
// 1. Session tracking is now three INDEPENDENT `if` blocks instead of an
//    if/else-if chain. The default windows overlap 13:00-16:00 (London +
//    New York both active); the old chain let London "win" that whole
//    window, so New York's open/high/low/close never saw its first 3
//    hours. Both sessions now update on every bar they're each active,
//    regardless of what else is active.
// 2. Session start-time capture no longer reconstructs a timestamp from
//    `timestamp(timezoneInput, year, month, dayofmonth, H, 0)` (where
//    year/month/dayofmonth are in the chart's EXCHANGE timezone, not
//    necessarily timezoneInput). It now just captures `time` directly on
//    the first bar each session becomes active -- `time` is an absolute
//    UTC-epoch value, so there is no timezone reconstruction to get wrong.
// 3. The daily reset condition is now
//    `ta.change(time("D", timezoneInput)) != 0` instead of comparing
//    `dayofmonth != dayofmonth[1]` -- fixes the na-comparison-on-bar-0
//    fragility (pine-proven-patterns skill gotcha #6) AND makes the reset
//    boundary track the selected timezone instead of the exchange's.
// 4. The 15-minute opening-range window and the Vol/2.5 SR volume divisor
//    are now inputs (orWindowMinutesInput, volumePivotDivisorInput) instead
//    of hardcoded literals. Both default to their original values, so
//    nothing changes unless you touch them.
// 5. "Slow MA on RSI" (tdiSlowMaLengthInput) was declared but never used.
//    It now drives a plotted TDI signal line (a standard second TDI line)
//    -- added as a new plot only, NOT folded into the existing bullish/
//    bearish arrow logic, so today's signals are unaffected; it's a new
//    visual reference line, not a new gate.
// 6. "Momentum Length" now has `group=G_TDI` like its TDI siblings, so it
//    displays grouped with them in Settings instead of sitting ungrouped
//    above.
// ============================================================================


// ============================================================================
// INPUTS -- SESSIONS & TREND THRESHOLD
// ----------------------------------------------------------------------------
// Left ungrouped, exactly as in the original (they appear above the
// explicit groups in the Settings panel because of that).
// ============================================================================

timezoneInput = input.string("UTC", "Tidszone", options=["UTC", "Europe/London", "America/New_York"])
asiaSessionInput = input.session("0000-0800", "Asien Session")
londonSessionInput = input.session("0800-1600", "London Session")
newYorkSessionInput = input.session("1300-2100", "New York Session")
trendThresholdInput = input.float(1.5, "Trend Tærskel", minval=1.0, step=0.1)
orWindowMinutesInput = input.int(15, "Opening Range Window (Minutes)", minval=1, maxval=120, tooltip="Was hardcoded to 15 minutes. Default unchanged.")


// ============================================================================
// INPUTS -- SR (SUPPORT/RESISTANCE) SETTINGS
// ============================================================================

srLookbackInput = input.int(20, "Lookback Period", minval=1, group="SR Settings")
volumeFilterLengthInput = input.int(2, "Delta Volume Filter Length", tooltip="Higher input filters low volume boxes", group="SR Settings")
boxWidthMultInput = input.float(1, "Adjust Box Width", maxval=1000, minval=0, step=0.1, group="SR Settings")
volumePivotDivisorInput = input.float(2.5, "Volume Pivot Divisor", minval=0.1, step=0.1, tooltip="Was a hardcoded /2.5 in the delta-volume high/low filter. Default unchanged.", group="SR Settings")


// ============================================================================
// INPUTS -- TRADERS DYNAMIC INDEX (TDI) & MOMENTUM
// ============================================================================

string G_TDI = 'Traders Dynamic Index Settings'

tdiRsiPeriodInput = input.int(21, minval=1, title="RSI Period", group=G_TDI)
tdiBandLengthInput = input.int(34, minval=1, title="Band Length", group=G_TDI)
tdiFastMaLengthInput = input.int(2, minval=1, title="Fast MA on RSI", group=G_TDI)
tdiSlowMaLengthInput = input.int(7, minval=0, title="Slow MA on RSI", group=G_TDI)
tdiSourceInput = input.source(close, title="TDI Source", group=G_TDI)
momentumLengthInput = input.int(12, minval=1, title="Momentum Length", group=G_TDI)


// ============================================================================
// SESSION DETECTION
// ============================================================================

asiaInSession = nz(time(timeframe.period, asiaSessionInput, timezoneInput), 0) != 0
londonInSession = nz(time(timeframe.period, londonSessionInput, timezoneInput), 0) != 0
nyInSession = nz(time(timeframe.period, newYorkSessionInput, timezoneInput), 0) != 0


// ============================================================================
// PER-SESSION OPEN / CLOSE / HIGH / LOW TRACKING
// ----------------------------------------------------------------------------
// FIXED (was #1 in the improvements list): these are now three INDEPENDENT
// `if` blocks, not an if/else-if chain. The default windows overlap
// 13:00-16:00 (London + New York both active); the old chain let whichever
// session was checked first "win" that whole window, so the other one's
// open/high/low/close never updated during the overlap. Every session that
// is active on a given bar now updates, regardless of what else is active.
// ============================================================================

var float asiaOpen = na
var float asiaClose = na
var float asiaHigh = na
var float asiaLow = na
var float londonOpen = na
var float londonClose = na
var float londonHigh = na
var float londonLow = na
var float nyOpen = na
var float nyClose = na
var float nyHigh = na
var float nyLow = na

if asiaInSession
    asiaOpen := na(asiaOpen) ? open : asiaOpen
    asiaClose := close
    asiaHigh := math.max(high, nz(asiaHigh, low))
    asiaLow := math.min(low, nz(asiaLow, high))

if londonInSession
    londonOpen := na(londonOpen) ? open : londonOpen
    londonClose := close
    londonHigh := math.max(high, nz(londonHigh, low))
    londonLow := math.min(low, nz(londonLow, high))

if nyInSession
    nyOpen := na(nyOpen) ? open : nyOpen
    nyClose := close
    nyHigh := math.max(high, nz(nyHigh, low))
    nyLow := math.min(low, nz(nyLow, high))


// ============================================================================
// OPENING RANGE (OR) -- FIRST 15 MINUTES OF EACH SESSION
// ============================================================================

var float asiaOrHigh = na
var float asiaOrLow = na
var float londonOrHigh = na
var float londonOrLow = na
var float nyOrHigh = na
var float nyOrLow = na
var int asiaSessionStartTime = na
var int londonSessionStartTime = na
var int nySessionStartTime = na
var box asiaOrBox = na
var box londonOrBox = na
var box nyOrBox = na

// Detect the start of each session by capturing the bar's own absolute
// timestamp directly, rather than reconstructing one from
// year/month/dayofmonth (which are in the chart's EXCHANGE timezone, not
// necessarily timezoneInput). `time` is an absolute UTC-epoch value, so
// there is no timezone to get wrong here.
if asiaInSession and na(asiaSessionStartTime)
    asiaSessionStartTime := time
if londonInSession and na(londonSessionStartTime)
    londonSessionStartTime := time
if nyInSession and na(nySessionStartTime)
    nySessionStartTime := time

int orWindowMs = orWindowMinutesInput * 60000

// Build the OR box over the first orWindowMinutesInput minutes (default 15,
// was hardcoded to 900000 ms) of each session.
if asiaInSession and time >= asiaSessionStartTime and time <= asiaSessionStartTime + orWindowMs
    asiaOrHigh := math.max(high, nz(asiaOrHigh, high))
    asiaOrLow := math.min(low, nz(asiaOrLow, low))
    if na(asiaOrBox)
        asiaOrBox := box.new(left=bar_index, top=high, right=bar_index+1, bottom=low, bgcolor=color.new(color.yellow, 90), border_color=color.yellow)
    else
        box.set_top(asiaOrBox, asiaOrHigh)
        box.set_bottom(asiaOrBox, asiaOrLow)
        box.set_right(asiaOrBox, bar_index + 1)
else if time > asiaSessionStartTime + orWindowMs and not na(asiaOrBox)
    box.set_right(asiaOrBox, bar_index)  // Freeze the box at the end of the OR window.

if londonInSession and time >= londonSessionStartTime and time <= londonSessionStartTime + orWindowMs
    londonOrHigh := math.max(high, nz(londonOrHigh, high))
    londonOrLow := math.min(low, nz(londonOrLow, low))
    if na(londonOrBox)
        londonOrBox := box.new(left=bar_index, top=high, right=bar_index+1, bottom=low, bgcolor=color.new(color.red, 90), border_color=color.red)
    else
        box.set_top(londonOrBox, londonOrHigh)
        box.set_bottom(londonOrBox, londonOrLow)
        box.set_right(londonOrBox, bar_index + 1)
else if time > londonSessionStartTime + orWindowMs and not na(londonOrBox)
    box.set_right(londonOrBox, bar_index)

if nyInSession and time >= nySessionStartTime and time <= nySessionStartTime + orWindowMs
    nyOrHigh := math.max(high, nz(nyOrHigh, high))
    nyOrLow := math.min(low, nz(nyOrLow, low))
    if na(nyOrBox)
        nyOrBox := box.new(left=bar_index, top=high, right=bar_index+1, bottom=low, bgcolor=color.new(color.blue, 90), border_color=color.blue)
    else
        box.set_top(nyOrBox, nyOrHigh)
        box.set_bottom(nyOrBox, nyOrLow)
        box.set_right(nyOrBox, bar_index + 1)
else if time > nySessionStartTime + orWindowMs and not na(nyOrBox)
    box.set_right(nyOrBox, bar_index)


// ============================================================================
// SESSION BACKGROUND HIGHLIGHT
// ============================================================================

bgcolor(asiaInSession ? color.new(color.yellow, 90) : na, title="Asien Session")
bgcolor(londonInSession ? color.new(color.red, 90) : na, title="London Session")
bgcolor(nyInSession ? color.new(color.blue, 90) : na, title="New York Session")


// ============================================================================
// SESSION PROFILE PATTERN DETECTION
// ============================================================================

asiaRange = asiaHigh - asiaLow
londonRange = londonHigh - londonLow
nyRange = nyHigh - nyLow
asiaDirection = nz(asiaClose, 0) > nz(asiaOpen, 0) ? 1 : (nz(asiaClose, 0) < nz(asiaOpen, 0) ? -1 : 0)
londonDirection = nz(londonClose, 0) > nz(londonOpen, 0) ? 1 : (nz(londonClose, 0) < nz(londonOpen, 0) ? -1 : 0)
nyDirection = nz(nyClose, 0) > nz(nyOpen, 0) ? 1 : (nz(nyClose, 0) < nz(nyOpen, 0) ? -1 : 0)
asiaTrending = nz(asiaRange, 0) > nz(ta.sma(asiaRange, 5), 0) * trendThresholdInput
londonTrending = nz(londonRange, 0) > nz(ta.sma(londonRange, 5), 0) * trendThresholdInput
londonConsolidating = nz(londonRange, 0) < nz(ta.sma(londonRange, 5), 0)
londonManipulatesAsiaHigh = nz(londonHigh, 0) > nz(asiaHigh, 0) and nz(londonLow, 0) < nz(asiaClose, 0)
londonManipulatesAsiaLow = nz(londonLow, 0) < nz(asiaLow, 0) and nz(londonHigh, 0) > nz(asiaClose, 0)
nyManipulatesLondonHigh = nz(nyHigh, 0) > nz(londonHigh, 0) and nz(nyLow, 0) < nz(londonClose, 0)
nyManipulatesLondonLow = nz(nyLow, 0) < nz(londonLow, 0) and nz(nyHigh, 0) > nz(londonClose, 0)


// ============================================================================
// PROFILE PREDICTION
// ============================================================================

var string nextProfile = "Ukendt"
if not nyInSession and londonInSession and not na(asiaHigh)
    if asiaTrending and londonTrending and asiaDirection == londonDirection
        nextProfile := "Profil 1: Trend Continuation"
    else if asiaTrending and londonConsolidating
        nextProfile := "Profil 2: NY Manipulation"
    else if not asiaTrending and (londonManipulatesAsiaHigh or londonManipulatesAsiaLow)
        if londonManipulatesAsiaHigh
            nextProfile := "Profil 3: London+NY Manipulation"
        else
            nextProfile := "Profil 4: Consolidation+Continuation"
    else
        nextProfile := "Ingen klar profil"


// ============================================================================
// SHORT / LONG CONDITION TEXT (BASED ON PREDICTED PROFILE + CURRENT PRICE)
// ============================================================================

var string shortCondition = "No Short"
var string longCondition = "No Long"
if barstate.islast
    if nextProfile == "Profil 1: Trend Continuation"
        if asiaDirection == 1 and londonDirection == 1
            if close < asiaHigh
                longCondition := "IF price hits " + str.tostring(asiaHigh) + " LONG (A/L/NY)"
            else
                longCondition := "No Long (over " + str.tostring(asiaHigh) + ")"
            shortCondition := "No Short"
        else if asiaDirection == -1 and londonDirection == -1
            if close > asiaLow
                shortCondition := "IF price hits " + str.tostring(asiaLow) + " SHORT (A/L/NY)"
            else
                shortCondition := "No Short (under " + str.tostring(asiaLow) + ")"
            longCondition := "No Long"
    else if nextProfile == "Profil 2: NY Manipulation"
        if asiaDirection == 1
            if close < asiaHigh
                longCondition := "IF price hits " + str.tostring(asiaHigh) + " LONG (A/L/NY)"
            else if nyInSession and close < londonHigh
                longCondition := "IF price hits " + str.tostring(londonHigh) + " LONG (NY)"
            else
                longCondition := "No Long (over " + str.tostring(londonHigh) + ")"
            if close > londonLow
                shortCondition := "IF price hits " + str.tostring(londonLow) + " SHORT (L/NY)"
            else
                shortCondition := "No Short (under " + str.tostring(londonLow) + ")"
        else if asiaDirection == -1
            if close > asiaLow
                shortCondition := "IF price hits " + str.tostring(asiaLow) + " SHORT (A/L/NY)"
            else if nyInSession and close > londonLow
                shortCondition := "IF price hits " + str.tostring(londonLow) + " SHORT (NY)"
            else
                shortCondition := "No Short (under " + str.tostring(londonLow) + ")"
            if close < londonHigh
                longCondition := "IF price hits " + str.tostring(londonHigh) + " LONG (L/NY)"
            else
                longCondition := "No Long (over " + str.tostring(londonHigh) + ")"
    else if nextProfile == "Profil 3: London+NY Manipulation"
        if close > asiaClose
            shortCondition := "IF price hits " + str.tostring(asiaClose) + " SHORT (L/NY)"
        else
            shortCondition := "No Short (under " + str.tostring(asiaClose) + ")"
        if close < asiaHigh
            longCondition := "IF price hits " + str.tostring(asiaHigh) + " LONG (L/NY)"
        else
            longCondition := "No Long (over " + str.tostring(asiaHigh) + ")"
    else if nextProfile == "Profil 4: Consolidation+Continuation"
        if close > asiaLow
            shortCondition := "IF price hits " + str.tostring(asiaLow) + " SHORT (L/NY)"
        else
            shortCondition := "No Short (under " + str.tostring(asiaLow) + ")"
        if close < asiaClose
            longCondition := "IF price hits " + str.tostring(asiaClose) + " LONG (L/NY)"
        else
            longCondition := "No Long (over " + str.tostring(asiaClose) + ")"
    else
        shortCondition := "No Short"
        longCondition := "No Long"


// ============================================================================
// DELTA VOLUME (CHARTPRIME)
// ============================================================================

f_upAndDownVolume() =>
    posVol = 0.0
    negVol = 0.0
    var isBuyVolume = true
    if close > open
        isBuyVolume := true
    else if close < open
        isBuyVolume := false
    if isBuyVolume
        posVol := posVol + volume
    else
        negVol := negVol - volume
    posVol + negVol


// ============================================================================
// SUPPORT / RESISTANCE (CHARTPRIME)
// ============================================================================

f_calcSupportResistance(srSource, srLookback) =>
    deltaVolume = f_upAndDownVolume()
    deltaVolumeHigh = ta.highest(deltaVolume / volumePivotDivisorInput, volumeFilterLengthInput)
    deltaVolumeLow = ta.lowest(deltaVolume / volumePivotDivisorInput, volumeFilterLengthInput)

    var float supportLevel = na
    var float supportBreakLevel = na
    var float resistanceLevel = na
    var float resistanceBreakLevel = na
    var box supportBox = na
    var box resistanceBox = na
    var color resistanceColor = color.new(color.red, 30)
    var color supportColor = color.new(color.green, 30)

    // Pine v6 will not accept plain `na` as a `var bool` initial value
    // (CE10173 -- see pine-proven-patterns skill gotcha #3). `false` is
    // behaviorally identical here: all four are unconditionally reassigned
    // via ta.crossover()/ta.crossunder() every single bar below, so this
    // seed value is only ever visible for the instant before that first
    // assignment.
    var bool resistanceBreakout = false
    var bool supportBreakout = false
    var bool resistanceHolds = false
    var bool supportHolds = false

    pivotHigh = ta.pivothigh(srSource, srLookback, srLookback)
    pivotLow = ta.pivotlow(srSource, srLookback, srLookback)
    atrValue = ta.atr(200)
    boxWidth = atrValue * boxWidthMultInput

    if (not na(pivotLow)) and deltaVolume > deltaVolumeHigh
        supportLevel := pivotLow
        supportBreakLevel := supportLevel - boxWidth
        topLeft = chart.point.from_index(bar_index - srLookback, supportLevel)
        bottomRight = chart.point.from_index(bar_index, supportBreakLevel)
        supportBox := box.new(
             top_left=topLeft,
             bottom_right=bottomRight,
             border_color=color.green,
             border_width=1,
             bgcolor=supportColor,
             text="Vol: " + str.tostring(math.round(deltaVolume, 2)),
             text_color=chart.fg_color,
             text_size=size.small
         )

    if (not na(pivotHigh)) and deltaVolume < deltaVolumeLow
        resistanceLevel := pivotHigh
        resistanceBreakLevel := resistanceLevel + boxWidth
        topLeft = chart.point.from_index(bar_index - srLookback, resistanceLevel)
        bottomRight = chart.point.from_index(bar_index, resistanceBreakLevel)
        resistanceBox := box.new(
             top_left=topLeft,
             bottom_right=bottomRight,
             border_color=color.red,
             border_width=1,
             bgcolor=resistanceColor,
             text="Vol: " + str.tostring(math.round(deltaVolume, 2)),
             text_color=chart.fg_color,
             text_size=size.small
         )

    if not na(supportBox)
        supportBox.set_right(bar_index + 1)
    if not na(resistanceBox)
        resistanceBox.set_right(bar_index + 1)

    resistanceBreakout := ta.crossover(low, resistanceBreakLevel)
    resistanceHolds := ta.crossunder(high, resistanceLevel)
    supportHolds := ta.crossover(low, supportLevel)
    supportBreakout := ta.crossunder(high, supportBreakLevel)

    if supportBreakout and not na(supportBox)
        supportBox.set_border_style(line.style_dashed)
    if supportHolds and not na(supportBox)
        supportBox.set_border_style(line.style_solid)
    if resistanceBreakout and not na(resistanceBox)
        resistanceBox.set_border_style(line.style_dashed)
    if resistanceHolds and not na(resistanceBox)
        resistanceBox.set_border_style(line.style_solid)

    [supportLevel, resistanceLevel, resistanceBreakout, resistanceHolds, supportHolds, supportBreakout]

[supportLevel, resistanceLevel, resistanceBreakout, resistanceHolds, supportHolds, supportBreakout] = f_calcSupportResistance(close, srLookbackInput)


// ============================================================================
// RESISTANCE <-> SUPPORT ROLLOVER TRACKING
// ============================================================================

// Same CE10173 fix as above -- both are only ever read inside plain
// boolean `and` expressions below (e.g. resistanceBecameSupport[1]), where
// `na` and `false` behave identically, so this changes nothing observable.
var bool resistanceBecameSupport = false
var bool supportBecameResistance = false
if resistanceBreakout
    resistanceBecameSupport := true
if resistanceHolds
    resistanceBecameSupport := false
if supportBreakout
    supportBecameResistance := true
if supportHolds
    supportBecameResistance := false


// ============================================================================
// INFO LABELS (PROFILE / SHORT / LONG)
// ============================================================================

var label profileLabel = na
var label shortLabel = na
var label longLabel = na
if barstate.islast
    if na(profileLabel)
        profileLabel := label.new(x=bar_index, y=high * 1.005, text="Session Profil: " + nextProfile, color=color.black, textcolor=color.white, style=label.style_label_down, size=size.small)
    label.set_text(profileLabel, "Session Profil: " + nextProfile)
    label.set_x(profileLabel, bar_index)
    label.set_y(profileLabel, high * 1.005)

    if na(shortLabel)
        shortLabel := label.new(x=bar_index, y=high * 1.003, text=shortCondition, color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
    label.set_text(shortLabel, shortCondition)
    label.set_x(shortLabel, bar_index)
    label.set_y(shortLabel, high * 1.003)

    if na(longLabel)
        longLabel := label.new(x=bar_index, y=high * 1.001, text=longCondition, color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
    label.set_text(longLabel, longCondition)
    label.set_x(longLabel, bar_index)
    label.set_y(longLabel, high * 1.001)


// ============================================================================
// SR BREAKOUT / HOLD MARKERS
// ============================================================================

plotchar(resistanceHolds, "Resistance Holds", "◆", color=#e92929, size=size.tiny, location=location.abovebar, offset=-1)
plotchar(supportHolds, "Support Holds", "◆", color=#20ca26, size=size.tiny, location=location.belowbar, offset=-1)
plotchar(resistanceBreakout and resistanceBecameSupport[1], "Resistance as Support Holds", "◆", color=#20ca26, size=size.tiny, location=location.belowbar, offset=-1)
plotchar(supportBreakout and supportBecameResistance[1], "Support as Resistance Holds", "◆", color=#e92929, size=size.tiny, location=location.abovebar, offset=-1)

if supportBreakout and not supportBecameResistance[1]
    label.new(bar_index[1], supportLevel[1], text="Break Sup", style=label.style_label_down, color=#7e1e1e, textcolor=chart.fg_color, size=size.small)
if resistanceBreakout and not resistanceBecameSupport[1]
    label.new(bar_index[1], resistanceLevel[1], text="Break Res", style=label.style_label_up, color=#2b6d2d, textcolor=chart.fg_color, size=size.small)


// ============================================================================
// SESSION HIGH / LOW LINES
// ============================================================================

plot(asiaHigh, "Asien High", color=color.yellow, style=plot.style_cross)
plot(asiaLow, "Asien Low", color=color.yellow, style=plot.style_cross)
plot(londonHigh, "London High", color=color.red, style=plot.style_cross)
plot(londonLow, "London Low", color=color.red, style=plot.style_cross)
plot(nyHigh, "NY High", color=color.blue, style=plot.style_cross)
plot(nyLow, "NY Low", color=color.blue, style=plot.style_cross)


// ============================================================================
// TDI & MOMENTUM
// ============================================================================

tdiRsi = ta.rsi(tdiSourceInput, tdiRsiPeriodInput)
tdiMa = ta.sma(tdiRsi, tdiBandLengthInput)
tdiOffset = 1.6185 * ta.stdev(tdiRsi, tdiBandLengthInput)
tdiUpperBand = tdiMa + tdiOffset
tdiLowerBand = tdiMa - tdiOffset
tdiFastMa = ta.sma(tdiRsi, tdiFastMaLengthInput)
// tdiSlowMaLengthInput was declared but never used anywhere -- it now drives
// a plotted TDI "Signal Line" (the standard second TDI line), added as a
// new plot ONLY. It is not folded into tdiBullishMove/tdiBearishMove below,
// so the existing Bullish/Bearish Arrow signals are unaffected.
tdiSlowMa = ta.sma(tdiRsi, tdiSlowMaLengthInput)
momentum = tdiSourceInput - tdiSourceInput[momentumLengthInput]
momentumRising = momentum > momentum[1]
momentumFalling = momentum < momentum[1]
tdiBullishMove = tdiFastMa > tdiUpperBand and tdiFastMa > 68
tdiBearishMove = tdiFastMa < tdiLowerBand and tdiFastMa < 32

plot(tdiSlowMa, "TDI Signal Line (Slow MA)", color=color.orange, display=display.data_window)
plotshape(tdiBullishMove and momentumRising ? high : na, style=shape.arrowup, color=color.new(color.lime, 0), size=size.normal, location=location.abovebar, title="Bullish Arrow")
plotshape(tdiBearishMove and momentumFalling ? low : na, style=shape.arrowdown, color=color.new(#FF0000, 0), size=size.normal, location=location.belowbar, title="Bearish Arrow")


// ============================================================================
// RESET ON NEW DAY
// ----------------------------------------------------------------------------
// FIXED (was #3 in the improvements list): `ta.change(time("D", timezoneInput)) != 0`
// replaces the old `dayofmonth != dayofmonth[1]` check. Main fix: the reset
// boundary now tracks the SELECTED timezone instead of the chart's exchange
// timezone, matching the sessions themselves (which are already defined via
// timezoneInput). This is also the same daily-reset idiom already proven
// elsewhere in this account's own Pine work (delta_break_retest/Stage8 and
// Stage9) -- na on bar 0 reads as falsy in the `if`, which is the correct
// "nothing to reset yet" behavior there, and every bar after that has a
// real value, so this doesn't carry gotcha #6's actual failure mode (a
// PERSISTENT var sentinel that never adopts a real value because every
// comparison against it silently resolves to na forever).
// ============================================================================

bool newDay = ta.change(time("D", timezoneInput)) != 0

if newDay
    asiaOpen := na
    asiaClose := na
    asiaHigh := na
    asiaLow := na
    londonOpen := na
    londonClose := na
    londonHigh := na
    londonLow := na
    nyOpen := na
    nyClose := na
    nyHigh := na
    nyLow := na
    asiaOrHigh := na
    asiaOrLow := na
    londonOrHigh := na
