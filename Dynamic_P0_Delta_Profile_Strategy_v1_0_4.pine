float signalStabilityMargin = input.float(
     0.0,
     "Signal Stability Margin",
     minval = 0.0,
     maxval = 20.0,
     step = 0.5,
     tooltip = "Extra headroom required above the raw score threshold before a signal counts as qualified. On a continuous/back-adjusted futures symbol (e.g. NQ1!), small historical revisions can nudge a score by a point or two -- a bar sitting right at the bare threshold can flip between qualifying and not on reload. This margin keeps borderline bars from ever counting as signals in the first place, so a small revision has nothing to flip. It does not fix the underlying data revision itself (that requires trading a fixed-expiry contract) -- it only makes the strategy's own output more stable against it.",
     group = G_ENTRY
)

bool useStructuralFilterInput = input.bool(
     true,
     "Block Entries Through Structural Resistance/Support",
     tooltip = "Long entries are blocked if price has already closed at or beyond the long-term Structural Resistance level; shorts are blocked at Structural Support. These structural levels only hold a real value from the current/most-recent bar onward (see the note above STRUCTURAL LEVEL STATE), so this filter only affects live, forward-going entries -- it has no effect on historical backtest bars.",
     group = G_ENTRY
)

bool useStructuralTargetInput = input.bool(
     true,
     "Cap Target At Nearest Structural Level",
     tooltip = "For Acceptance entries, if Structural Resistance (longs) / Structural Support (shorts) sits between entry and the flat Acceptance Target (R) multiple, take profit AT that structural level instead of pushing the target past a real overhead/underfoot wall. Falls back to the plain R-multiple target when no closer structural level exists. Same live-only caveat as the filter above.",
     group = G_ENTRY
)

