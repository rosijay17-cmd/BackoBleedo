//@version=6
strategy(
     title = "Dynamic P0 Delta Profile Strategy v1.0.4 Armed + Entry Markers",
     shorttitle = "P0 Delta Strategy",
     overlay = true,
     initial_capital = 100000,
     pyramiding = 0,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 2.50,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_order_fills = true,
     calc_on_every_tick = true,
     use_bar_magnifier = false,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_lines_count = 300,
     max_labels_count = 300
)

//=============================================================================
// MODEL
//-----------------------------------------------------------------------------
// STRUCTURAL LAYER
// • Up to 120 calendar days.
// • Estimated positive / negative delta distributed across price.
// • Structural POC, VAH, VAL.
// • Delta support / resistance.
// • High-delta liquidity zones.
// • Right-side price-level delta histogram.
// • Histogram/Profile Price Bars input supports 20–160 true price bins.
//
// DYNAMIC LAYER
// • Rolling P0 equilibrium. Default = 4 hours.
// • Dynamic P0 + dynamic value area.
// • Acceptance / rejection scoring.
//
// ACCEPTANCE COMPONENTS
// • P0 migration.
// • P0 catch-up.
// • New-location volume.
// • Value-area migration.
// • Delta alignment / persistence.
// • Dwell outside equilibrium.
// • Price / delta efficiency.
//
// REJECTION COMPONENTS
// • P0 stall.
// • Opposing delta.
// • Absorption.
// • Return toward P0.
// • Value non-migration.
// • Weak new-location volume.
//
// ENTRY TYPES
// BULL | LONG ENTRY | ACCEPTANCE CONTINUATION
// BEAR | SHORT ENTRY | ACCEPTANCE CONTINUATION
// BULL | LONG ENTRY | REJECTION TO P0
// BEAR | SHORT ENTRY | REJECTION TO P0
//
// IMPORTANT:
// Pine does not expose native bid/ask aggressor volume here.
// Delta is estimated from OHLCV candle pressure.
//=============================================================================


//=============================================================================
// 01 — STRUCTURAL PROFILE
//=============================================================================

string G_STRUCT = "01 — Structural Profile"

int structuralDays = input.int(
     120,
     "Lookback Days",
     minval = 1,
     maxval = 120,
     group = G_STRUCT
)

int structuralRows = input.int(
     80,
     "Histogram / Profile Price Bars",
     minval = 20,
     maxval = 160,
     step = 10,
     tooltip = "Controls the number of actual price bins used by the structural delta profile. Higher values draw more histogram bars and provide finer POC, VAH/VAL, delta-node, support/resistance, and liquidity-zone resolution. Higher values also require more processing.",
     group = G_STRUCT
)

int maxStoredBars = input.int(
     25000,
     "Maximum Stored Chart Bars",
     minval = 1000,
     maxval = 50000,
     step = 1000,
     group = G_STRUCT
)

float structuralValueArea = input.float(
     70.0,
     "Value Area %",
     minval = 50.0,
     maxval = 95.0,
     step = 1.0,
     group = G_STRUCT
)

float minNodeVolume = input.float(
     25.0,
     "Minimum Node Volume (% Of POC)",
     minval = 0.0,
     maxval = 100.0,
     step = 5.0,
     group = G_STRUCT
)

float minNodeDelta = input.float(
     10.0,
     "Minimum Absolute Delta %",
     minval = 0.0,
     maxval = 100.0,
     step = 1.0,
     group = G_STRUCT
)

int liquidityNodeCount = input.int(
     4,
     "High-Delta Liquidity Zones",
     minval = 1,
     maxval = 8,
     group = G_STRUCT
)


