     "Show Price Trend EMAs",
     group=GRP_DISPLAY)

bool showSignals = input.bool(
     true,
     "Show Entry Markers",
     group=GRP_DISPLAY)

bool showStops = input.bool(
     true,
     "Show Active Stop",
     group=GRP_DISPLAY)

bool colorTrendBackground = input.bool(
     true,
     "Color Background By Forecast",
     group=GRP_DISPLAY)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERT INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool enableDynamicAlerts = input.bool(
     true,
     "Enable Dynamic alert() Calls",
     tooltip="Fires an explicit alert() call on every entry, labeled BULLISH/BEARISH with symbol, forecast, and stop. Works with a TradingView alert set to 'Any alert() function call'. The named alertcondition()s below work too, and strategy.entry/exit alert_message text works with an 'Order fills' alert -- pick whichever condition you prefer when creating the alert.",
     group=GRP_ALERTS)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COLORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
color C_BULL    = color.rgb(0, 140, 255)
color C_BEAR    = color.rgb(160, 90, 255)
color C_GOOD    = color.rgb(20, 185, 100)
color C_WARN    = color.rgb(245, 155, 20)
color C_BAD     = color.rgb(240, 55, 75)
color C_NEUTRAL = color.rgb(95, 105, 125)
color C_DARK    = color.rgb(10, 18, 30)
color C_CELL    = color.rgb(24, 35, 53)
color C_TEXT    = color.white

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(maximum, value))

f_forecast(
     float source,
     int fastLength,
     int slowLength,
     int calibrationLength,
     float capValue) =>

    float fastAverage = ta.ema(source, fastLength)
    float slowAverage = ta.ema(source, slowLength)
    float rawSignal = fastAverage - slowAverage
    float meanAbsoluteSignal = ta.sma(
         math.abs(rawSignal),
         calibrationLength)

    float result = 0.0

    if not na(meanAbsoluteSignal) and meanAbsoluteSignal > 0.0
        result := rawSignal / meanAbsoluteSignal * 10.0

    f_clamp(result, -capValue, capValue)

f_directionColor(float value) =>
    color result = C_NEUTRAL

    if value > 0.0
        result := C_BULL
    else if value < 0.0
        result := C_BEAR

    result

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ATR AND NORMALIZED PRICE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float atrValue = ta.atr(atrLen)

float normalizedReturn = 0.0

if bar_index > 0 and not na(atrValue) and atrValue > 0.0
    normalizedReturn := (close - close[1]) / atrValue

var float normalizedPrice = 100.0

if barstate.isfirst
    normalizedPrice := 100.0
else
    normalizedPrice += normalizedReturn

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MULTI-SPEED FORECASTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float forecast1 = f_forecast(
     normalizedPrice,
     fast1,
     slow1,
     forecastCalibrationLen,
     individualForecastCap)

float forecast2 = f_forecast(
     normalizedPrice,
     fast2,
     slow2,
     forecastCalibrationLen,
     individualForecastCap)

float forecast3 = f_forecast(
     normalizedPrice,
     fast3,
     slow3,
     forecastCalibrationLen,
     individualForecastCap)

float rawCombinedForecast =
     (forecast1 + forecast2 + forecast3) / 3.0

rawCombinedForecast *= forecastDiversification

rawCombinedForecast := f_clamp(
     rawCombinedForecast,
     -combinedForecastCap,
     combinedForecastCap)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VOLATILITY REGIME
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float logReturn = na

if bar_index > 0 and close > 0.0 and close[1] > 0.0
    logReturn := math.log(close / close[1])

float currentPctVol = ta.stdev(
     logReturn,
     currentVolLen)

float longRunPctVol = ta.sma(
     currentPctVol,
     longVolLen)

float relativeVolatility = na

if not na(longRunPctVol) and longRunPctVol > 0.0
    relativeVolatility := currentPctVol / longRunPctVol

float volatilityRank = ta.percentrank(
     relativeVolatility,
     volRankLen)

float volatilityQuantile = 0.50

if not na(volatilityRank)
    volatilityQuantile := volatilityRank / 100.0

float rawVolMultiplier = math.pow(
     2.0,
     1.0 - 2.0 * volatilityQuantile)

rawVolMultiplier := f_clamp(
     rawVolMultiplier,
     minimumVolMultiplier,
     maximumVolMultiplier)

float smoothedVolMultiplier = ta.ema(
     rawVolMultiplier,
     volMultiplierSmooth)

float appliedVolMultiplier = 1.0

if useVolAdjustment and not na(smoothedVolMultiplier)
    appliedVolMultiplier := smoothedVolMultiplier

float adjustedForecast =
     rawCombinedForecast * appliedVolMultiplier

adjustedForecast := f_clamp(
     adjustedForecast,
     -combinedForecastCap,
     combinedForecastCap)

bool extremeVolatility =
     not na(volatilityRank) and
     volatilityRank >= extremeVolRank

bool volatilityEntryOK =
     not blockExtremeVol or
     not extremeVolatility

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CONFIRMED HTF FILTER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
int chartSeconds = timeframe.in_seconds(timeframe.period)
int htfSeconds = timeframe.in_seconds(htfTimeframe)

bool htfValid = htfSeconds > chartSeconds

[htfCloseConfirmed, htfFastConfirmed, htfSlowConfirmed] =
     request.security(
          syminfo.tickerid,
          htfTimeframe,
          [
               close[1],
               ta.ema(close, htfFastLen)[1],
               ta.ema(close, htfSlowLen)[1]
          ],
          gaps=barmerge.gaps_off,
          lookahead=barmerge.lookahead_on)

bool htfBull =
     htfValid and
     htfCloseConfirmed > htfFastConfirmed and
     htfFastConfirmed > htfSlowConfirmed

bool htfBear =
     htfValid and
     htfCloseConfirmed < htfFastConfirmed and
     htfFastConfirmed < htfSlowConfirmed

bool longHtfOK =
     not useHtfFilter or
     not htfValid or
     htfBull

bool shortHtfOK =
     not useHtfFilter or
     not htfValid or
     htfBear

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Produces sweepBuySignal / sweepSellSignal. These only drive longSignal /
// shortSignal (below, in ENTRY CONDITIONS) when useSweepEntry is on --
// otherwise the original forecast-crossover trigger is used instead. This
// section always runs regardless of the toggle (cheap: a handful of
// pivots and a bounded array scan), matching how crossoverLongSignal /
// crossoverShortSignal are also always computed.
//
// "No counter-trend" is enforced entirely inside sweepBuyConfirmed /
// sweepSellConfirmed below: a sweep can only confirm once BOTH the local
// 20/50 EMA stack and the EWMAC/HTF trend regime already agree with its
// direction. Raw sweep detection (validBuySweep / validSellSweep) stays
// trend-agnostic, exactly like the source indicator -- the trend gate is
// applied only at confirmation.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

float sweepAtrValue = ta.atr(sweepAtrLen)
float sweepFastMa = ta.ema(close, sweepFastMaLen)
float sweepSlowMa = ta.ema(close, sweepSlowMaLen)

float sweepCandleRange = high - low
float sweepCandleBody  = math.abs(close - open)
float sweepUpperWick   = high - math.max(open, close)
float sweepLowerWick   = math.min(open, close) - low

float sweepBodyPercent      = sweepCandleRange > 0 ? sweepCandleBody / sweepCandleRange : 0.0
float sweepUpperWickPercent = sweepCandleRange > 0 ? sweepUpperWick / sweepCandleRange : 0.0
float sweepLowerWickPercent = sweepCandleRange > 0 ? sweepLowerWick / sweepCandleRange : 0.0

float sweepMinDistancePx = not na(sweepAtrValue) ? sweepMinDistanceAtr * sweepAtrValue : na
float sweepMinRangePx    = not na(sweepAtrValue) ? sweepMinRangeAtr * sweepAtrValue : na

float sweepPivotHigh = ta.pivothigh(high, sweepPivotLength, sweepPivotLength)
float sweepPivotLow  = ta.pivotlow(low, sweepPivotLength, sweepPivotLength)

var float[] sweepStoredHighLevels = array.new_float()
var int[]   sweepStoredHighBars   = array.new_int()
var float[] sweepStoredLowLevels  = array.new_float()
var int[]   sweepStoredLowBars    = array.new_int()

if not na(sweepPivotHigh)
    array.push(sweepStoredHighLevels, sweepPivotHigh)
    array.push(sweepStoredHighBars, bar_index - sweepPivotLength)
    if array.size(sweepStoredHighLevels) > sweepStoredLevels
        array.shift(sweepStoredHighLevels)
        array.shift(sweepStoredHighBars)

if not na(sweepPivotLow)
    array.push(sweepStoredLowLevels, sweepPivotLow)
    array.push(sweepStoredLowBars, bar_index - sweepPivotLength)
    if array.size(sweepStoredLowLevels) > sweepStoredLevels
        array.shift(sweepStoredLowLevels)
        array.shift(sweepStoredLowBars)

float sweptHighLevel = na
int   sweptHighBar   = na
float sweptLowLevel  = na
int   sweptLowBar    = na

int sweepHighLevelCount = array.size(sweepStoredHighLevels)
if sweepHighLevelCount > 0
    for i = sweepHighLevelCount - 1 to 0
        float highLevel = array.get(sweepStoredHighLevels, i)
        int   highBar   = array.get(sweepStoredHighBars, i)
        if highBar < bar_index and high > highLevel and not na(sweepMinDistancePx) and (high - highLevel) >= sweepMinDistancePx
            sweptHighLevel := highLevel
            sweptHighBar   := highBar
            break

int sweepLowLevelCount = array.size(sweepStoredLowLevels)
if sweepLowLevelCount > 0
    for i = sweepLowLevelCount - 1 to 0
        float lowLevel = array.get(sweepStoredLowLevels, i)
        int   lowBar   = array.get(sweepStoredLowBars, i)
        if lowBar < bar_index and low < lowLevel and not na(sweepMinDistancePx) and (lowLevel - low) >= sweepMinDistancePx
            sweptLowLevel := lowLevel
            sweptLowBar   := lowBar
            break

bool sweepBearishReclaim =
     not na(sweptHighLevel) and
     (
         sweepReclaimRule == "Close Back Inside" ?
         close < sweptHighLevel :
         close < sweptHighLevel and close < (high + low) / 2.0
     )

bool sweepBullishReclaim =
     not na(sweptLowLevel) and
     (
         sweepReclaimRule == "Close Back Inside" ?
         close > sweptLowLevel :
         close > sweptLowLevel and close > (high + low) / 2.0
     )

bool validSellSweep =
     not na(sweptHighLevel) and
     sweepBearishReclaim and
     sweepUpperWickPercent >= sweepMinWickPercent and
     sweepBodyPercent <= sweepMaxBodyPercent and
     not na(sweepMinRangePx) and
     sweepCandleRange >= sweepMinRangePx

bool validBuySweep =
     not na(sweptLowLevel) and
     sweepBullishReclaim and
     sweepLowerWickPercent >= sweepMinWickPercent and
     sweepBodyPercent <= sweepMaxBodyPercent and
     not na(sweepMinRangePx) and
     sweepCandleRange >= sweepMinRangePx

var int   sweepPendingBullBar = na
var float sweepPendingBullMid = na

var int   sweepPendingBearBar = na
var float sweepPendingBearMid = na

if validBuySweep
    sweepPendingBullBar := bar_index
    sweepPendingBullMid := (high + low) / 2.0

if validSellSweep
    sweepPendingBearBar := bar_index
    sweepPendingBearMid := (high + low) / 2.0

bool sweepBullWindowOpen = not na(sweepPendingBullBar) and (bar_index - sweepPendingBullBar <= sweepConfirmationWindow)
bool sweepBearWindowOpen = not na(sweepPendingBearBar) and (bar_index - sweepPendingBearBar <= sweepConfirmationWindow)

// "No counter-trend" gate: local 20/50 EMA stack.
bool sweepLocalLongOk  = close > sweepFastMa and close > sweepSlowMa
bool sweepLocalShortOk = close < sweepFastMa and close < sweepSlowMa

// "No counter-trend" gate: EWMAC forecast + confirmed HTF trend regime.
bool sweepMacroLongOk  = adjustedForecast >= entryForecast and longHtfOK
bool sweepMacroShortOk = adjustedForecast <= -entryForecast and shortHtfOK

bool sweepBullBodyOk = not sweepRequireBullishBody or close > open
bool sweepBearBodyOk = not sweepRequireBearishBody or close < open
bool sweepBullMidOk  = not sweepRequireMidlineBreak or close > sweepPendingBullMid
bool sweepBearMidOk  = not sweepRequireMidlineBreak or close < sweepPendingBearMid

bool sweepBuyConfirmed =
     sweepBullWindowOpen and
     sweepBullBodyOk and
     sweepLocalLongOk and
     sweepMacroLongOk and
     sweepBullMidOk

bool sweepSellConfirmed =
     sweepBearWindowOpen and
     sweepBearBodyOk and
     sweepLocalShortOk and
     sweepMacroShortOk and
     sweepBearMidOk

var int sweepLastSignalBar = na
bool sweepSpacingOK = na(sweepLastSignalBar) or (bar_index - sweepLastSignalBar > sweepSignalSpacingBars)

bool sweepBuySignal  = sweepBuyConfirmed and sweepSpacingOK
bool sweepSellSignal = sweepSellConfirmed and sweepSpacingOK and not sweepBuySignal

if sweepBuySignal or sweepSellSignal
    sweepLastSignalBar := bar_index

if sweepBuySignal or (not na(sweepPendingBullBar) and bar_index - sweepPendingBullBar > sweepConfirmationWindow)
    sweepPendingBullBar := na
    sweepPendingBullMid := na

if sweepSellSignal or (not na(sweepPendingBearBar) and bar_index - sweepPendingBearBar > sweepConfirmationWindow)
    sweepPendingBearBar := na
    sweepPendingBearMid := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION AND FREQUENCY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool inTradingSession = not na(
     time(
          timeframe.period,
          tradingSession,
          sessionTimezone))

bool sessionOK =
     not useSessionFilter or
     inTradingSession

bool sessionEnded =
     bar_index > 0 and
     not inTradingSession and
     inTradingSession[1]

int dayIdentifier =
     year(time, sessionTimezone) * 10000 +
     month(time, sessionTimezone) * 100 +
     dayofmonth(time, sessionTimezone)

bool newTradingDay =
     barstate.isfirst or
     dayIdentifier != dayIdentifier[1]

var int tradesToday = 0

if newTradingDay
    tradesToday := 0

bool dailyTradeLimitOK =
     tradesToday < maximumTradesPerDay

var int lastExitBar = na

bool cooldownOK =
     na(lastExitBar) or
     bar_index - lastExitBar >= cooldownBars

int cooldownRemaining = 0

if not cooldownOK and not na(lastExitBar)
    cooldownRemaining := math.max(
         0,
         cooldownBars - (bar_index - lastExitBar))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY CONDITIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool longAccelerationOK = true
bool shortAccelerationOK = true

if requireForecastAcceleration
    longAccelerationOK :=
         adjustedForecast > adjustedForecast[accelerationLookback]

    shortAccelerationOK :=
         adjustedForecast < adjustedForecast[accelerationLookback]

bool crossoverLongSignal = ta.crossover(
     adjustedForecast,
     entryForecast)

bool crossoverShortSignal = ta.crossunder(
     adjustedForecast,
     -entryForecast)

// Trigger source switch: sweep-and-reclaim (trend-aligned, no counter-trend)
// or the original forecast-crossover, per useSweepEntry.
bool longSignal = useSweepEntry ? sweepBuySignal : crossoverLongSignal
bool shortSignal = useSweepEntry ? sweepSellSignal : crossoverShortSignal

bool longContext =
     allowLong and
     volatilityEntryOK and
     sessionOK and
     dailyTradeLimitOK and
     cooldownOK and
     longHtfOK and
     longAccelerationOK

bool shortContext =
     allowShort and
     volatilityEntryOK and
     sessionOK and
     dailyTradeLimitOK and
     cooldownOK and
     shortHtfOK and
     shortAccelerationOK

bool flat = strategy.position_size == 0

bool longEntry =
     barstate.isconfirmed and
     longSignal and
     longContext and
     (
          flat or
          (
               reverseOnOppositeSignal and
               strategy.position_size < 0
          )
     )

bool shortEntry =
     barstate.isconfirmed and
     shortSignal and
     shortContext and
     (
          flat or
          (
               reverseOnOppositeSignal and
               strategy.position_size > 0
          )
     ) and
     not longEntry

bool longForecastExit =
     barstate.isconfirmed and
     strategy.position_size > 0 and
     adjustedForecast <= -exitForecast

bool shortForecastExit =
     barstate.isconfirmed and
     strategy.position_size < 0 and
     adjustedForecast >= exitForecast

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GLOBAL ROLLING CALCULATIONS
// These must execute on every calculation.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float structureLowest = ta.lowest(
     low,
     structureLookback)

float structureHighest = ta.highest(
     high,
     structureLookback)

float rollingTrailHighest = ta.highest(
     high,
     trailLookback)

float rollingTrailLowest = ta.lowest(
     low,
     trailLookback)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INITIAL STOP CANDIDATES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float atrLongStop =
     close - atrValue * initialStopAtr

float atrShortStop =
     close + atrValue * initialStopAtr

float structureLongStop =
     structureLowest - atrValue * structureBufferAtr

float structureShortStop =
     structureHighest + atrValue * structureBufferAtr

float candidateLongStop = atrLongStop
float candidateShortStop = atrShortStop

if stopMode == "Structure"
    candidateLongStop := structureLongStop
    candidateShortStop := structureShortStop

else if stopMode == "Hybrid"
    candidateLongStop := math.min(
         atrLongStop,
         structureLongStop)

    candidateShortStop := math.max(
         atrShortStop,
         structureShortStop)

float minimumStopDistance = math.max(
     syminfo.mintick * 2.0,
     atrValue * 0.05)

candidateLongStop := math.min(
     candidateLongStop,
     close - minimumStopDistance)

candidateShortStop := math.max(
     candidateShortStop,
     close + minimumStopDistance)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// POSITION SIZING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float pointValue = syminfo.pointvalue

if na(pointValue) or pointValue <= 0.0
    pointValue := 1.0

float longRiskDistance =
     close - candidateLongStop

float shortRiskDistance =
     candidateShortStop - close

float riskBudget = riskDollars

if sizingMode == "Risk %"
    riskBudget :=
         strategy.equity * riskPercent / 100.0

float longQuantity = fixedContracts
float shortQuantity = fixedContracts

if sizingMode != "Fixed"
    if longRiskDistance > syminfo.mintick
        longQuantity := math.floor(
             riskBudget /
             (longRiskDistance * pointValue))

    if shortRiskDistance > syminfo.mintick
        shortQuantity := math.floor(
             riskBudget /
             (shortRiskDistance * pointValue))

bool longSizeOK = longQuantity >= 1.0
bool shortSizeOK = shortQuantity >= 1.0

longEntry := longEntry and longSizeOK
shortEntry := shortEntry and shortSizeOK

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PERSISTENT TRADE STATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float activeEntry = na
var float activeStop = na
var float initialRisk = na
var float highestSinceEntry = na
var float lowestSinceEntry = na
var int entryBar = na
var bool breakEvenMoved = false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRIES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if longEntry
    activeEntry := close
    activeStop := candidateLongStop
    initialRisk := activeEntry - activeStop
    highestSinceEntry := high
    lowestSinceEntry := low
    entryBar := bar_index
    breakEvenMoved := false
    tradesToday += 1

    strategy.entry(
         "Long",
         strategy.long,
         qty=longQuantity,
         comment="EWMAC Long",
         alert_message="AMSEWMAC BULLISH ENTRY - LONG")

    if enableDynamicAlerts
        alert(
             "AMSEWMAC BULLISH ENTRY | LONG | " +
             syminfo.ticker +
             " | Forecast " + str.tostring(adjustedForecast, "#.0") +
             " | Stop " + str.tostring(candidateLongStop, format.mintick),
             alert.freq_once_per_bar_close)

if shortEntry
    activeEntry := close
    activeStop := candidateShortStop
    initialRisk := activeStop - activeEntry
    highestSinceEntry := high
    lowestSinceEntry := low
    entryBar := bar_index
    breakEvenMoved := false
    tradesToday += 1

    strategy.entry(
         "Short",
         strategy.short,
         qty=shortQuantity,
         comment="EWMAC Short",
         alert_message="AMSEWMAC BEARISH ENTRY - SHORT")

    if enableDynamicAlerts
        alert(
             "AMSEWMAC BEARISH ENTRY | SHORT | " +
             syminfo.ticker +
             " | Forecast " + str.tostring(adjustedForecast, "#.0") +
             " | Stop " + str.tostring(candidateShortStop, format.mintick),
             alert.freq_once_per_bar_close)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TRAILING VALUES
// Calculated globally on every update.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float calculatedLongTrail =
     rollingTrailHighest - atrValue * trailAtrMult

float calculatedShortTrail =
     rollingTrailLowest + atrValue * trailAtrMult

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LONG POSITION MANAGEMENT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if strategy.position_size > 0
    highestSinceEntry := math.max(
         nz(highestSinceEntry, high),
         high)

    lowestSinceEntry := math.min(
         nz(lowestSinceEntry, low),
         low)

    if useTrailingStop
        activeStop := math.max(
             nz(activeStop, candidateLongStop),
             calculatedLongTrail)

    if useBreakEven and not breakEvenMoved and not na(initialRisk)
        bool longBreakEvenReached =
             high >= strategy.position_avg_price +
             initialRisk * breakEvenTriggerR

        if longBreakEvenReached
            activeStop := math.max(
                 nz(activeStop, strategy.position_avg_price),
                 strategy.position_avg_price)

            breakEvenMoved := true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SHORT POSITION MANAGEMENT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if strategy.position_size < 0
    highestSinceEntry := math.max(
         nz(highestSinceEntry, high),
         high)

    lowestSinceEntry := math.min(
         nz(lowestSinceEntry, low),
         low)

    if useTrailingStop
        activeStop := math.min(
             nz(activeStop, candidateShortStop),
             calculatedShortTrail)

    if useBreakEven and not breakEvenMoved and not na(initialRisk)
        bool shortBreakEvenReached =
             low <= strategy.position_avg_price -
             initialRisk * breakEvenTriggerR

        if shortBreakEvenReached
            activeStop := math.min(
                 nz(activeStop, strategy.position_avg_price),
                 strategy.position_avg_price)

            breakEvenMoved := true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PROTECTIVE STOPS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if strategy.position_size > 0 and not na(activeStop)
    strategy.exit(
         "Long Stop",
         from_entry="Long",
         stop=activeStop,
         alert_message="AMSEWMAC STOP EXIT - LONG")

if strategy.position_size < 0 and not na(activeStop)
    strategy.exit(
         "Short Stop",
         from_entry="Short",
         stop=activeStop,
         alert_message="AMSEWMAC STOP EXIT - SHORT")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FORECAST EXITS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if longForecastExit
    strategy.close(
         "Long",
         comment="Forecast Exit",
         alert_message="AMSEWMAC FORECAST EXIT - LONG")

if shortForecastExit
    strategy.close(
         "Short",
         comment="Forecast Exit",
         alert_message="AMSEWMAC FORECAST EXIT - SHORT")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIME AND SESSION EXITS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool holdingTimeExpired =
     maximumHoldingBars > 0 and
     strategy.position_size != 0 and
     not na(entryBar) and
     bar_index - entryBar >= maximumHoldingBars

if holdingTimeExpired
    strategy.close_all(
         comment="Time Exit",
         alert_message="AMSEWMAC TIME EXIT")

if flattenAtSessionEnd and sessionEnded and strategy.position_size != 0
    strategy.close_all(
         comment="Session Exit",
         immediately=true,
         alert_message="AMSEWMAC SESSION EXIT")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CLOSED-POSITION RESET
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool positionJustClosed =
     strategy.position_size == 0 and
     strategy.position_size[1] != 0

// v1.1 COOLDOWN FIX: a reversal (short -> long or long -> short in a
// single combined order, submitted whenever reverseOnOppositeSignal is
// on) never sets strategy.position_size to exactly 0 on any bar -- it
// flips sign directly (e.g. -1 to +1). positionJustClosed alone
// therefore never fired on a reversal, so lastExitBar (and cooldownOK)
// never registered a reversal as an exit at all -- the strategy could
// reverse back and forth with zero cooldown enforcement between
// reversals, which is what "cooldown is not working" was actually
// describing. Fixed by also tracking position sign flips as an exit
// for cooldown purposes, while the full trade-state reset below still
// only runs on a genuine flat close (a reversal's activeEntry/
// activeStop/etc. are already correctly refreshed by the ENTRIES
// section above on the same bar).
bool positionReversed =
     strategy.position_size != 0 and
     strategy.position_size[1] != 0 and
     math.sign(strategy.position_size) != math.sign(strategy.position_size[1])

if positionJustClosed or positionReversed
    lastExitBar := bar_index

if positionJustClosed
    activeEntry := na
    activeStop := na
    initialRisk := na
    highestSinceEntry := na
    lowestSinceEntry := na
    entryBar := na
    breakEvenMoved := false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BLOCKER TEXT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
string longBlocker = "CLEAR"

if not allowLong
    longBlocker := "LONG OFF"
else if not volatilityEntryOK
    longBlocker := "EXTREME VOL"
else if not sessionOK
    longBlocker := "SESSION"
else if not dailyTradeLimitOK
    longBlocker := "DAY LIMIT"
else if not cooldownOK
    longBlocker := "COOLDOWN"
else if not longHtfOK
    longBlocker := "HTF BLOCK"
else if not longAccelerationOK
    longBlocker := "NO ACCEL"
else if adjustedForecast < entryForecast
    longBlocker := "FORECAST LOW"
else if not longSizeOK
    longBlocker := "SIZE ZERO"
else if strategy.position_size > 0
    longBlocker := "ALREADY LONG"

string shortBlocker = "CLEAR"

if not allowShort
    shortBlocker := "SHORT OFF"
else if not volatilityEntryOK
    shortBlocker := "EXTREME VOL"
else if not sessionOK
    shortBlocker := "SESSION"
else if not dailyTradeLimitOK
    shortBlocker := "DAY LIMIT"
else if not cooldownOK
    shortBlocker := "COOLDOWN"
else if not shortHtfOK
    shortBlocker := "HTF BLOCK"
else if not shortAccelerationOK
    shortBlocker := "NO ACCEL"
else if adjustedForecast > -entryForecast
    shortBlocker := "FORECAST LOW"
else if not shortSizeOK
    shortBlocker := "SIZE ZERO"
else if strategy.position_size < 0
    shortBlocker := "ALREADY SHORT"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PRICE TREND GUIDES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float priceFastEma = ta.ema(close, fast2)
float priceSlowEma = ta.ema(close, slow2)

plot(
     showTrendEMAs ? priceFastEma : na,
     "Trend Fast EMA",
     color=C_BULL,
     linewidth=1)

plot(
     showTrendEMAs ? priceSlowEma : na,
     "Trend Slow EMA",
     color=C_WARN,
     linewidth=2)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// STOP AND ENTRY PLOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float activeStopPlot =
     showStops and strategy.position_size != 0
     ? activeStop
     : na

plot(
     activeStopPlot,
     "Active Stop",
     color=C_BAD,
     linewidth=2,
     style=plot.style_linebr)

plotshape(
     showSignals and longEntry,
     title="Long Entry",
     text="LONG",
     style=shape.labelup,
     location=location.belowbar,
     color=C_BULL,
     textcolor=color.white,
     size=size.small)

plotshape(
     showSignals and shortEntry,
     title="Short Entry",
     text="SHORT",
     style=shape.labeldown,
     location=location.abovebar,
     color=C_BEAR,
     textcolor=color.white,
     size=size.small)

plotshape(
     showSweepMarkers and validBuySweep,
     title="Raw Bull Sweep",
     style=shape.circle,
     location=location.belowbar,
     color=color.new(C_BULL, 40),
     size=size.tiny)

plotshape(
     showSweepMarkers and validSellSweep,
     title="Raw Bear Sweep",
     style=shape.circle,
     location=location.abovebar,
     color=color.new(C_BEAR, 40),
     size=size.tiny)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BACKGROUND
// bgcolor is called once in global scope.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
color trendBackground = na

if adjustedForecast >= entryForecast
    trendBackground := color.new(C_BULL, 90)
else if adjustedForecast <= -entryForecast
    trendBackground := color.new(C_BEAR, 90)

bgcolor(
     colorTrendBackground
     ? trendBackground
     : na)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DASHBOARD POSITION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
dashPosition =
     dashboardPosition == "Top Left"
     ? position.top_left
     : dashboardPosition == "Bottom Right"
     ? position.bottom_right
     : dashboardPosition == "Bottom Left"
     ? position.bottom_left
     : position.top_right

var table dash = table.new(
     position=dashPosition,
     columns=2,
     rows=19,
     bgcolor=C_DARK,
     border_color=color.rgb(60, 75, 95),
     border_width=1,
     frame_color=C_BULL,
     frame_width=2)

f_row(
     int row,
     string labelText,
     string valueText,
     color valueColor) =>

    table.cell(
         dash,
         0,
         row,
         labelText,
         bgcolor=C_DARK,
         text_color=C_TEXT,
         text_size=size.tiny,
         text_halign=text.align_left)

    table.cell(
         dash,
         1,
         row,
         valueText,
         bgcolor=valueColor,
         text_color=C_TEXT,
         text_size=size.small,
         text_halign=text.align_right)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIVE DASHBOARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if showDashboard and barstate.islast
    string positionText = "FLAT"
    color positionColor = C_NEUTRAL

    if strategy.position_size > 0
        positionText := "LONG"
        positionColor := C_BULL
    else if strategy.position_size < 0
        positionText := "SHORT"
        positionColor := C_BEAR

    string signalText = "WAIT"
    color signalColor = C_NEUTRAL

    if longEntry
        signalText := "LONG ENTRY"
        signalColor := C_BULL
    else if shortEntry
        signalText := "SHORT ENTRY"
        signalColor := C_BEAR
    else if adjustedForecast >= entryForecast and longContext
        signalText := "LONG READY"
        signalColor := C_BULL
    else if adjustedForecast <= -entryForecast and shortContext
        signalText := "SHORT READY"
        signalColor := C_BEAR

    string biasText = "NEUTRAL"
    color biasColor = C_NEUTRAL

    if adjustedForecast >= entryForecast
        biasText := "BULL"
        biasColor := C_BULL
    else if adjustedForecast <= -entryForecast
        biasText := "BEAR"
        biasColor := C_BEAR

    string volText = "NORMAL"
    color volColor = C_GOOD

    if not na(volatilityRank)
        if volatilityRank >= extremeVolRank
            volText := "EXTREME"
            volColor := C_BAD
        else if volatilityRank >= 75.0
            volText := "HIGH"
            volColor := C_WARN
        else if volatilityRank <= 25.0
            volText := "LOW"
            volColor := C_BULL

    string htfText = "OFF"
    color htfColor = C_NEUTRAL

    if useHtfFilter
        if not htfValid
            htfText := "INVALID TF"
            htfColor := C_WARN
        else if htfBull
            htfText := "BULL"
            htfColor := C_BULL
        else if htfBear
            htfText := "BEAR"
            htfColor := C_BEAR
        else
            htfText := "NEUTRAL"
            htfColor := C_NEUTRAL

    string stopText = "N/A"

    if strategy.position_size != 0 and not na(activeStop)
        stopText := str.tostring(
             activeStop,
             format.mintick)

    string tradeText =
         str.tostring(tradesToday) +
         "/" +
         str.tostring(maximumTradesPerDay)

    string cooldownText = "READY"
    color cooldownColor = C_GOOD

    if not cooldownOK
        cooldownText :=
             str.tostring(cooldownRemaining) +
             " BARS"

        cooldownColor := C_WARN

    color longBlockColor =
         longBlocker == "CLEAR"
         ? C_GOOD
         : longBlocker == "ALREADY LONG"
         ? C_BULL
         : C_WARN

    color shortBlockColor =
         shortBlocker == "CLEAR"
         ? C_GOOD
         : shortBlocker == "ALREADY SHORT"
         ? C_BEAR
         : C_WARN

    color stopColor =
         strategy.position_size == 0
         ? C_NEUTRAL
         : C_BAD

    color tradeColor =
         dailyTradeLimitOK
         ? C_CELL
         : C_BAD

    string entryModeText = useSweepEntry ? "SWEEP" : "CROSSOVER"
    color entryModeColor = useSweepEntry ? C_GOOD : C_NEUTRAL

    string sweepTrendText =
         sweepLocalLongOk
         ? "ABOVE 20/50"
         : sweepLocalShortOk
         ? "BELOW 20/50"
         : "MIXED"

    color sweepTrendColor =
         sweepLocalLongOk
         ? C_BULL
         : sweepLocalShortOk
         ? C_BEAR
         : C_NEUTRAL

    f_row(
         0,
         "SYSTEM",
         "MULTI EWMAC",
         C_CELL)

    f_row(
         1,
         "POSITION",
         positionText,
         positionColor)

    f_row(
         2,
         "SIGNAL",
         signalText,
         signalColor)

    f_row(
         3,
         "BIAS",
         biasText,
         biasColor)

    f_row(
         4,
         "FORECAST",
         str.tostring(adjustedForecast, "#.0"),
         f_directionColor(adjustedForecast))

    f_row(
         5,
         "SPEED 1",
         str.tostring(forecast1, "#.0"),
         f_directionColor(forecast1))

    f_row(
         6,
         "SPEED 2",
         str.tostring(forecast2, "#.0"),
         f_directionColor(forecast2))

    f_row(
         7,
         "SPEED 3",
         str.tostring(forecast3, "#.0"),
         f_directionColor(forecast3))

    f_row(
         8,
         "VOL RANK",
         str.tostring(volatilityRank, "#.0") +
         " " +
         volText,
         volColor)

    f_row(
         9,
         "VOL MULT",
         str.tostring(appliedVolMultiplier, "#.00") +
         "x",
         volColor)

    f_row(
         10,
         "HTF",
         htfText,
         htfColor)

    f_row(
         11,
         "L BLOCK",
         longBlocker,
         longBlockColor)

    f_row(
         12,
         "S BLOCK",
         shortBlocker,
         shortBlockColor)

    f_row(
         13,
         "STOP",
         stopText,
         stopColor)

    f_row(
         14,
         "COOLDOWN",
         cooldownText,
         cooldownColor)

    f_row(
         15,
         "TRADES",
         tradeText,
         tradeColor)

    f_row(
         16,
         "ALERTS",
         enableDynamicAlerts ? "ON" : "OFF",
         enableDynamicAlerts ? C_GOOD : C_NEUTRAL)

    f_row(
         17,
         "ENTRY MODE",
         entryModeText,
         entryModeColor)

    f_row(
         18,
         "SWEEP TREND",
         sweepTrendText,
         sweepTrendColor)

if not showDashboard and barstate.islast
    table.clear(
         dash,
         0,
         0,
         1,
         18)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
alertcondition(
     longEntry,
     title="Adaptive EWMAC Long",
     message="AMSEWMAC BULLISH ENTRY (LONG) on {{ticker}} {{interval}}")

alertcondition(
     shortEntry,
     title="Adaptive EWMAC Short",
     message="AMSEWMAC BEARISH ENTRY (SHORT) on {{ticker}} {{interval}}")

alertcondition(
     longForecastExit or shortForecastExit,
     title="Adaptive EWMAC Forecast Exit",
     message="Adaptive multi-speed EWMAC forecast exit on {{ticker}} {{interval}}")
