//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RISK INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
string sizingMode = input.string(
     "Risk %",
     "Position Sizing",
     options=["Fixed", "Risk %", "Risk $"],
     group=GRP_RISK)

float fixedContracts = input.float(
     1.0,
     "Fixed Contracts",
