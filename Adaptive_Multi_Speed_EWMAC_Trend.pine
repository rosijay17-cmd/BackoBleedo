strategy(
     title="Adaptive Multi-Speed EWMAC Trend",
     shorttitle="AMSEWMAC",
     overlay=true,
     pyramiding=0,
     process_orders_on_close=true,
     calc_on_every_tick=true,
     calc_on_order_fills=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed,
     default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=2.50,
     slippage=1,
     max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUT GROUPS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
string GRP_TREND   = "01 - Diversified Trend"
string GRP_VOL     = "02 - Volatility Adjustment"
string GRP_ENTRY   = "03 - Entry and Exit"
string GRP_HTF     = "04 - Higher Timeframe"
string GRP_RISK    = "05 - Risk Management"
string GRP_SESSION = "06 - Session and Frequency"
string GRP_DISPLAY = "07 - Display"
string GRP_ALERTS  = "08 - Alerts"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
int atrLen = input.int(
     32,
     "Normalization ATR Length",
     minval=2,
     group=GRP_TREND)

int fast1 = input.int(
     8,
     "Fast Speed 1",
     minval=2,
     group=GRP_TREND)

int slow1 = input.int(
     32,
     "Slow Speed 1",
     minval=4,
     group=GRP_TREND)

int fast2 = input.int(
     16,
     "Fast Speed 2",
     minval=2,
     group=GRP_TREND)

int slow2 = input.int(
     64,
     "Slow Speed 2",
     minval=4,
     group=GRP_TREND)

int fast3 = input.int(
     32,
     "Fast Speed 3",
     minval=2,
     group=GRP_TREND)

int slow3 = input.int(
     128,
     "Slow Speed 3",
     minval=4,
     group=GRP_TREND)

int forecastCalibrationLen = input.int(
     250,
     "Forecast Calibration Length",
     minval=50,
     group=GRP_TREND)

float forecastDiversification = input.float(
     1.20,
     "Forecast Diversification Multiplier",
     minval=0.50,
     maxval=2.00,
     step=0.05,
     group=GRP_TREND)

float individualForecastCap = input.float(
     20.0,
     "Individual Forecast Cap",
     minval=5.0,
     maxval=50.0,
     step=1.0,
     group=GRP_TREND)

float combinedForecastCap = input.float(
     20.0,
     "Combined Forecast Cap",
     minval=5.0,
     maxval=50.0,
     step=1.0,
     group=GRP_TREND)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VOLATILITY INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool useVolAdjustment = input.bool(
     true,
     "Adjust Forecast By Volatility",
     group=GRP_VOL)

int currentVolLen = input.int(
     32,
     "Current Volatility Length",
     minval=5,
     group=GRP_VOL)

int longVolLen = input.int(
     500,
     "Long-Run Volatility Length",
     minval=100,
     group=GRP_VOL)

int volRankLen = input.int(
     500,
     "Volatility Percentile Length",
     minval=100,
     group=GRP_VOL)

int volMultiplierSmooth = input.int(
     10,
     "Volatility Multiplier Smoothing",
     minval=1,
     group=GRP_VOL)

float minimumVolMultiplier = input.float(
     0.50,
     "Minimum Volatility Multiplier",
     minval=0.10,
     maxval=1.00,
     step=0.05,
     group=GRP_VOL)

float maximumVolMultiplier = input.float(
     2.00,
     "Maximum Volatility Multiplier",
     minval=1.00,
     maxval=4.00,
     step=0.05,
     group=GRP_VOL)

bool blockExtremeVol = input.bool(
     false,
     "Block Extreme Volatility Entries",
     group=GRP_VOL)

float extremeVolRank = input.float(
     95.0,
     "Extreme Volatility Percentile",
     minval=75.0,
     maxval=100.0,
     step=1.0,
     group=GRP_VOL)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY AND EXIT INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float entryForecast = input.float(
     5.0,
     "Entry Forecast Threshold",
     minval=0.0,
     maxval=20.0,
     step=0.5,
     group=GRP_ENTRY)

float exitForecast = input.float(
     0.0,
     "Opposite Forecast Exit Threshold",
     minval=0.0,
     maxval=10.0,
     step=0.5,
     group=GRP_ENTRY)

bool requireForecastAcceleration = input.bool(
     false,
     "Require Forecast Acceleration",
     group=GRP_ENTRY)

int accelerationLookback = input.int(
     3,
     "Forecast Acceleration Lookback",
     minval=1,
     maxval=20,
     group=GRP_ENTRY)

bool allowLong = input.bool(
     true,
     "Allow Longs",
     group=GRP_ENTRY)

bool allowShort = input.bool(
     true,
     "Allow Shorts",
     group=GRP_ENTRY)

bool reverseOnOppositeSignal = input.bool(
     true,
     "Reverse On Opposite Signal",
     group=GRP_ENTRY)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP ENTRY INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Ported from the user's "Liquidity Entry Zones [trade_w_samet]" indicator.
// Replaces the plain forecast-crossover trigger with a liquidity-sweep +
// reclaim trigger: price sweeps a recent swing high/low -- which in a live
// trend routinely clusters just beyond the 20/50 EMA -- then reclaims it
// with a quality confirmation candle. Both the local 20/50 EMA stack AND
// the EWMAC/HTF trend regime must already agree with the sweep's
// direction before it can arm a trade: a bearish sweep can never fire
// while the trend regime is bullish, and vice versa. This makes the
// sweep a trend-continuation pullback entry, never a counter-trend
// reversal signal.

bool useSweepEntry = input.bool(
     true,
     "Use Liquidity Sweep Entry (No Counter-Trend)",
     tooltip="When on, entries fire on a trend-aligned liquidity sweep + reclaim instead of a raw forecast crossover. A bullish sweep only arms when the EWMAC/HTF trend regime and the local EMA stack are already bullish; a bearish sweep only arms when both are already bearish -- countertrend sweeps are never taken. When off, the original forecast-crossover trigger is used.",
     group=GRP_ENTRY)

int sweepFastMaLen = input.int(
     20,
     "Sweep: Local Fast EMA Length",
     minval=2,
     group=GRP_ENTRY)

int sweepSlowMaLen = input.int(
     50,
     "Sweep: Local Slow EMA Length",
     minval=3,
     group=GRP_ENTRY)

int sweepPivotLength = input.int(
     5,
     "Sweep: Swing Pivot Length",
     minval=1,
     group=GRP_ENTRY)

int sweepStoredLevels = input.int(
     20,
     "Sweep: Stored Liquidity Levels",
     minval=5,
     maxval=100,
     group=GRP_ENTRY)

int sweepAtrLen = input.int(
     14,
     "Sweep: ATR Length",
     minval=1,
     group=GRP_ENTRY)

float sweepMinDistanceAtr = input.float(
     0.10,
     "Sweep: Minimum Sweep Distance / ATR",
     minval=0.01,
     step=0.01,
     group=GRP_ENTRY)

string sweepReclaimRule = input.string(
     "Close Back Inside",
     "Sweep: Reclaim Rule",
     options=["Close Back Inside", "Strong Reclaim"],
     group=GRP_ENTRY)

float sweepMinWickPercent = input.float(
     0.35,
     "Sweep: Minimum Wick %",
     minval=0.0,
     maxval=1.0,
     step=0.01,
     group=GRP_ENTRY)

float sweepMaxBodyPercent = input.float(
     0.65,
     "Sweep: Maximum Body %",
     minval=0.05,
     maxval=1.0,
     step=0.01,
     group=GRP_ENTRY)

float sweepMinRangeAtr = input.float(
     0.20,
     "Sweep: Minimum Candle Range / ATR",
     minval=0.01,
     step=0.01,
     group=GRP_ENTRY)

bool sweepRequireBullishBody = input.bool(
     true,
     "Sweep: Long Confirmation Must Be Bullish",
     group=GRP_ENTRY)

bool sweepRequireBearishBody = input.bool(
     true,
     "Sweep: Short Confirmation Must Be Bearish",
     group=GRP_ENTRY)

int sweepConfirmationWindow = input.int(
     2,
     "Sweep: Max Bars After Sweep For Confirmation",
     minval=0,
     maxval=10,
     group=GRP_ENTRY)

bool sweepRequireMidlineBreak = input.bool(
     true,
     "Sweep: Require Sweep Candle Midline Break",
     group=GRP_ENTRY)

int sweepSignalSpacingBars = input.int(
     10,
     "Sweep: Minimum Bars Between Sweep Signals",
     minval=0,
     group=GRP_ENTRY)

bool showSweepMarkers = input.bool(
     true,
     "Sweep: Show Raw Sweep Markers",
     group=GRP_ENTRY)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// HIGHER-TIMEFRAME INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
