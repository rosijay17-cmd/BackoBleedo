//@version=6
//@strategy_alert_message {{strategy.order.alert_message}} | {{ticker}} | {{interval}} | Fill: {{strategy.order.price}}

strategy("Institutional ORB v6 (Boxes + Regime + Fakeout)", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1)

// ==========================================
// --- INPUTS ---
// ==========================================
// 1. Dynamic Time Settings
orbStart       = input.string("0930", title="ORB Start Time (HHMM)", group="Dynamic Time Settings")
orbEnd         = input.string("1000", title="ORB End Time (HHMM)", group="Dynamic Time Settings")
tradingEnd     = input.string("1600", title="Trading Session End (HHMM)", group="Dynamic Time Settings")
timezone       = input.string("America/New_York", title="Session Timezone", group="Dynamic Time Settings")

// 2. Risk Settings
riskPct        = input.float(25.0, title="Stop Loss % of Range", minval=1.0, maxval=100.0, group="Risk Management", tooltip="Stop loss size as a percentage of the total range width")
rrMultiple     = input.float(5.0, title="Risk Reward Multiple", group="Risk Management")
forceClose     = input.bool(true, title="Force Close at Session End?", group="Risk Management")

// 3. Layer 1: Markov-Proxy Regime Switcher Settings
// NOTE: adxLength/bbSqueezeLen are fixed BAR-COUNT lookbacks, not fixed
// TIME windows -- 14-20 bars is ~3.5-5 hours of real time on a 15m chart
// but only 14-20 MINUTES on a 1m chart. Dropping to a lower timeframe
// without retuning these means the regime classifier sees a much shorter,
// noisier slice of the day and calls it "ranging" far more often, and
// entries are strictly blocked whenever isRangingRegime is true -- this is
// almost certainly why entries look fine at 15m and vanish below it.
// useRegimeFilter (default on, so 15m behavior is unchanged) lets you
// bypass that block entirely to confirm the diagnosis before retuning:
// watch the HUD's "MARKET REGIME" cell on your target lower timeframe --
// if it reads RANGING almost constantly, that confirms it, and the real
// fix is shortening adxLength/bbSqueezeLen (and probably adxThreshold) to
// match that timeframe's own rhythm, not leaving the filter off for good.
useRegimeFilter = input.bool(true, title="Enable Ranging-Regime Entry Block", group="Layer 1: Regime Switcher")
adxLength      = input.int(14, title="ADX Length", group="Layer 1: Regime Switcher")
adxThreshold   = input.int(25, title="ADX Trend Threshold", group="Layer 1: Regime Switcher")
bbSqueezeLen   = input.int(20, title="Squeeze BB Length", group="Layer 1: Regime Switcher")
bbSqueezeMult  = input.float(2.0, title="Squeeze BB Multiplier", group="Layer 1: Regime Switcher")
kcSqueezeMult  = input.float(1.5, title="Squeeze Keltner Multiplier", group="Layer 1: Regime Switcher")

// 4. Sub-Strategy B: Fakeout Breakout Filters
useVolumeFilter = input.bool(true, title="Enable Volume Confirmation?", group="Breakout Filters")
volLength       = input.int(20, title="Volume Average Length", group="Breakout Filters")
volMultiplier   = input.float(1.5, title="Volume Multiplier (x SMA)", group="Breakout Filters")

useWickFilter   = input.bool(true, title="Enable Rejection Wick Filter?", group="Breakout Filters")
maxWickPct      = input.float(35.0, title="Max Rejection Wick %", group="Breakout Filters")

useAtrPenetration  = input.bool(true, title="Enable ATR Penetration Filter?", group="Breakout Filters")
atrPenetrationMult = input.float(0.5, title="Min ATR Penetration Multiplier", group="Breakout Filters")

// 5. ORB Range Display -- rebuilt to match the "ORB Range Breakout
// [NSE/BSE]" reference the user pasted: flat plotted levels + a bgcolor
// session highlight instead of a box, with labels anchored near the
// CURRENT bar (redrawn every last-bar update via labelOffset) instead of
// fixed at the range's start bar -- the fixed-position version scrolled
// off the left edge of the screen on a long trading day, which is what
// the user didn't like about the prior version.
showMidline        = input.bool(true, title="Show Midline", tooltip="The midline often acts as intraday support/resistance after breakout.", group="ORB Range Display")
color orbHighColor = input.color(color.new(#26a69a, 0), title="ORB High Color", group="ORB Range Display")
color orbLowColor  = input.color(color.new(#ef5350, 0), title="ORB Low Color", group="ORB Range Display")
color midlineColor = input.color(color.new(#ff9800, 50), title="Midline Color", group="ORB Range Display")
color orbBgColor   = input.color(color.new(color.blue, 92), title="ORB Session Background", group="ORB Range Display")
showOrbLabels      = input.bool(true, title="Show Price Labels", group="ORB Range Display")
string labelSizeInput = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="ORB Range Display")
labelOffset        = input.int(1, title="Label Offset (bars)", minval=0, maxval=50, tooltip="Horizontal distance of labels from the latest candle, in bars.", group="ORB Range Display")

// 6. ORB Range Context -- target projections + ATR-normalized range
// quality (Narrow / Normal / Wide), same methodology as before, redrawn
// using the reference's technique: a fixed 30-bar trailing segment near
// current price, refreshed every last-bar update, rather than one line
// extended live from the actual breakout bar.
showTargetProjections = input.bool(true, title="Show Target Projections", group="ORB Range Context")
target1Mult      = input.float(1.0, title="Target 1 (x Range)", minval=0.1, step=0.1, group="ORB Range Context")
target2Mult      = input.float(1.5, title="Target 2 (x Range)", minval=0.1, step=0.1, group="ORB Range Context")
target3Mult      = input.float(2.0, title="Target 3 (x Range)", minval=0.1, step=0.1, group="ORB Range Context")
color targetColor = input.color(color.new(#00bcd4, 30), title="Target Lines Color", group="ORB Range Context")
showRangeQuality = input.bool(true, title="Show Range Quality", tooltip="Compares the OR range to ATR to classify it as Narrow/Normal/Wide.", group="ORB Range Context")
rangeAtrLength   = input.int(14, title="Range Quality ATR Length", minval=5, maxval=50, group="ORB Range Context")
narrowThreshold  = input.float(0.5, title="Narrow Range (< x ATR)", minval=0.1, step=0.05, group="ORB Range Context")
wideThreshold    = input.float(1.2, title="Wide Range (> x ATR)", minval=0.1, step=0.05, group="ORB Range Context")

// 7. ORB Info Panel -- a small dedicated table for the ORB range's own
// stats (Range / Quality / Range-vs-ATR / Breakout direction), separate
// from the existing regime HUD below so neither gets crowded.
showInfoPanel   = input.bool(true, title="Show ORB Info Panel", group="ORB Info Panel")
string tableSizeInput = input.string("Small", "Info Table Size", options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group="ORB Info Panel")
string themeSelect    = input.string("Dark", "Info Panel Theme", options=["Dark", "Light"], group="ORB Info Panel")

// ==========================================
// --- DYNAMIC SESSION CONCATENATION ---
// ==========================================
string orbSession     = orbStart + "-" + orbEnd
string tradingSession = orbEnd + "-" + tradingEnd

// ==========================================
// --- LAYER 1: REGIME SWITCHER ENGINE ---
// ==========================================
// Volatility Compression (Squeeze Detection)
basisSqueeze = ta.sma(close, bbSqueezeLen)
devSqueeze   = bbSqueezeMult * ta.stdev(close, bbSqueezeLen)
upperBB      = basisSqueeze + devSqueeze
lowerBB      = basisSqueeze - devSqueeze

atrValSqueeze = ta.atr(bbSqueezeLen)
upperKC       = basisSqueeze + (atrValSqueeze * kcSqueezeMult)
lowerKC       = basisSqueeze - (atrValSqueeze * kcSqueezeMult)

bool isSqueezed = (upperBB < upperKC) and (lowerBB > lowerKC)

// Trend Momentum (ADX)
[diPlus, diMinus, adxValue] = ta.dmi(adxLength, adxLength)

// Regime Classification
int regimeState = 2
if isSqueezed
    regimeState := 0
else if adxValue >= adxThreshold
    regimeState := 1
else
    regimeState := 2

bool isRangingRegime = regimeState == 2

// ==========================================
// --- HELPERS ---
// ==========================================
f_priceStr(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

// Convert the label/table size dropdown strings into size.* constants,
// same switch-based pattern as the reference indicator.
f_labelSize(string sizeStr) =>
    switch sizeStr
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.small

f_tableSize(string sizeStr) =>
    switch sizeStr
        "Auto" => size.auto
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.small

f_themeColors() =>
    if themeSelect == "Light"
        [color.new(color.white, 15), color.black, color.new(#e3e3e3, 30)]
    else
        [color.new(color.black, 85), color.white, color.new(color.blue, 70)]

// ==========================================
// --- RANGE TRACKING ---
// ==========================================
// Rebuilt to match the reference: no box, no live-growing visuals during
// the OR window itself (just the bgcolor highlight below) -- the range
// only gets drawn/labeled once it's finalized. orbHigh/orbLow simply
// carry the last-known range through non-session hours until the next
// isNewSession overwrites them fresh; no separate "reset to na on new
// day" step is needed (and the prior version's version of that step had
// a latent ordering hazard on RTH-only chart data, where isNewSession and
// a new calendar day land on the exact same bar -- this sidesteps it
// entirely rather than papering over it).
bool validTF = timeframe.isintraday

var float orbHigh = na
var float orbLow  = na

bool inOrbSession = not na(time(timeframe.period, orbSession, timezone))
bool isNewSession = inOrbSession and not inOrbSession[1]

if isNewSession
    orbHigh := high
    orbLow  := low
else if inOrbSession
    orbHigh := math.max(orbHigh, high)
    orbLow  := math.min(orbLow, low)

bool  rangeSet       = validTF and not inOrbSession and not na(orbHigh)
float orbMid         = (orbHigh + orbLow) / 2
float orbRangeWidth  = orbHigh - orbLow

// ATR-normalized range-quality classification (Narrow / Normal / Wide),
// computed once the range is set and held (var) until the next one.
float rangeAtr = ta.atr(rangeAtrLength)
float rangeRatio = orbRangeWidth / rangeAtr

var string rangeQuality      = "-"
var color  rangeQualityColor = color.gray

if rangeSet and not na(rangeAtr) and rangeAtr > 0
    if rangeRatio < narrowThreshold
        rangeQuality := "NARROW"
        rangeQualityColor := color.new(#4caf50, 0)
    else if rangeRatio > wideThreshold
        rangeQuality := "WIDE"
        rangeQualityColor := color.new(#f44336, 0)
    else
        rangeQuality := "NORMAL"
        rangeQualityColor := color.new(#2196f3, 0)

// Target levels for both directions, computed unconditionally every bar
// (cheap arithmetic) -- only the relevant set gets drawn below, gated by
// which direction actually broke out.
float t1Long  = orbHigh + orbRangeWidth * target1Mult
float t2Long  = orbHigh + orbRangeWidth * target2Mult
float t3Long  = orbHigh + orbRangeWidth * target3Mult
float t1Short = orbLow - orbRangeWidth * target1Mult
float t2Short = orbLow - orbRangeWidth * target2Mult
float t3Short = orbLow - orbRangeWidth * target3Mult

// ==========================================
// --- FAKEOUT BREAKOUT FILTERS ---
// ==========================================
// 1. Volume Filter
volMa = ta.sma(volume, volLength)
bool isVolumeConfirmed = not useVolumeFilter or (volume > (volMa * volMultiplier))

// 2. Rejection Wick Filter
candleRange = high - low
upperWick   = high - math.max(open, close)
lowerWick   = math.min(open, close) - low

bool longWickOK  = not useWickFilter or (candleRange > 0 ? (upperWick / candleRange) * 100 <= maxWickPct : true)
bool shortWickOK = not useWickFilter or (candleRange > 0 ? (lowerWick / candleRange) * 100 <= maxWickPct : true)

// 3. ATR Penetration (Clearance distance)
atrVal = ta.atr(14)
bool longAtrPenetration  = not useAtrPenetration or ((close - orbHigh) >= (atrVal * atrPenetrationMult))
bool shortAtrPenetration = not useAtrPenetration or ((orbLow - close) >= (atrVal * atrPenetrationMult))

// Combined validation checks
bool isLongBreakoutValid  = isVolumeConfirmed and longWickOK and longAtrPenetration
bool isShortBreakoutValid = isVolumeConfirmed and shortWickOK and shortAtrPenetration

// ==========================================
// --- EXECUTION ENGINE ---
// ==========================================
bool inTradingWindow = not na(time(timeframe.period, tradingSession, timezone))

var bool longTaken  = false
var bool shortTaken = false
var string firstBreakoutDir = "NONE"

if ta.change(time("D")) != 0
    longTaken  := false
    shortTaken := false
    firstBreakoutDir := "NONE"

// Trigger breakouts on close confirmation outside the range boundaries
bool rawLongTrigger  = rangeSet and inTradingWindow and not longTaken and ta.crossover(close, orbHigh)
bool rawShortTrigger = rangeSet and inTradingWindow and not shortTaken and ta.crossunder(close, orbLow)

// ORB Entries are strictly blocked during Ranging Regimes (isRangingRegime
// == true), unless useRegimeFilter is turned off.
bool longTrigger  = rawLongTrigger and (not useRegimeFilter or not isRangingRegime) and isLongBreakoutValid
bool shortTrigger = rawShortTrigger and (not useRegimeFilter or not isRangingRegime) and isShortBreakoutValid

var float activeSL = na
var float activeTP = na

float slDistance = (orbHigh - orbLow) * (riskPct / 100.0)

// 1. Long Entry
if longTrigger
    longTaken := true
    activeSL  := close - slDistance
    activeTP  := close + (slDistance * rrMultiple)
    strategy.entry("Long", strategy.long, comment="ORB LONG")
    if firstBreakoutDir == "NONE"
        firstBreakoutDir := "LONG"

// 2. Short Entry
if shortTrigger
    shortTaken := true
    activeSL   := close + slDistance
    activeTP   := close - (slDistance * rrMultiple)
    strategy.entry("Short", strategy.short, comment="ORB SHORT")
    if firstBreakoutDir == "NONE"
        firstBreakoutDir := "SHORT"

// ==========================================
// --- EXIT ENGINE ---
// ==========================================
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP, comment="SL/TP Exit")

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP, comment="SL/TP Exit")

// End of trading window force-close
bool sessionJustEnded = not inTradingWindow and inTradingWindow[1]
if forceClose and sessionJustEnded and strategy.position_size != 0
    strategy.close_all(comment="Session Ended - Force Close")

// ==========================================
// --- VISUALIZATIONS & HUD ---
// ==========================================
// ORB High/Low/Mid as flat plotted levels (not a box) -- only visible
// once the range is finalized, exactly like the reference. plot()/
// bgcolor()/plotshape() must be called unconditionally at the top level
// in Pine, so the on/off toggle lives in the value expression (na when
// not applicable), not around the call itself.
plot(validTF and rangeSet ? orbHigh : na, "ORB High", orbHighColor, 2, plot.style_linebr)
plot(validTF and rangeSet ? orbLow : na, "ORB Low", orbLowColor, 2, plot.style_linebr)
plot(validTF and rangeSet and showMidline ? orbMid : na, "ORB Mid", midlineColor, 1, plot.style_linebr)

bgcolor(inOrbSession ? orbBgColor : na, title="ORB Session")

// Shapes representing verified breakouts
plotshape(longTrigger, title="ORB Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="ORB BUY")
plotshape(shortTrigger, title="ORB Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="ORB SELL")

// NEW: labels + target-projection lines, redrawn every last-bar update
// and anchored near the CURRENT bar (bar_index + labelOffset) so they
// stay visible near live price action all day, rather than fixed at the
// range's start bar. Separate long/short line AND label variable sets --
// the reference indicator this was modeled on shares one label-variable
// set between its long and short target blocks, which silently orphans
// the long labels if both a long and a short breakout happen on the same
// day (nothing ever deletes them); kept the fix in since it costs nothing
// and this strategy's longTaken/shortTaken already allow exactly that
// same-day-both-directions case.
var label orbHighLbl = na
var label orbLowLbl  = na
var label midLbl     = na

var line  t1LongLine = na
var line  t2LongLine = na
var line  t3LongLine = na
var line  t1ShortLine = na
var line  t2ShortLine = na
var line  t3ShortLine = na
var label t1LongLbl = na
var label t2LongLbl = na
var label t3LongLbl = na
var label t1ShortLbl = na
var label t2ShortLbl = na
var label t3ShortLbl = na

if barstate.islast and validTF and rangeSet
    label.delete(orbHighLbl)
    label.delete(orbLowLbl)
    label.delete(midLbl)
    line.delete(t1LongLine)
    line.delete(t2LongLine)
    line.delete(t3LongLine)
    line.delete(t1ShortLine)
    line.delete(t2ShortLine)
    line.delete(t3ShortLine)
    label.delete(t1LongLbl)
    label.delete(t2LongLbl)
    label.delete(t3LongLbl)
    label.delete(t1ShortLbl)
    label.delete(t2ShortLbl)
    label.delete(t3ShortLbl)

    int startBar = bar_index - 30
    string selectedLabelSize = f_labelSize(labelSizeInput)

    if showOrbLabels
        string highSuffix = showRangeQuality and rangeQuality != "-" ? "  [" + rangeQuality + " " + str.tostring(rangeRatio, "#.##") + "x ATR]" : ""
        orbHighLbl := label.new(bar_index + labelOffset, orbHigh, "ORB H: " + f_priceStr(orbHigh) + highSuffix,
             style=label.style_label_left, color=color.new(orbHighColor, 85), textcolor=orbHighColor, size=selectedLabelSize)
        orbLowLbl := label.new(bar_index + labelOffset, orbLow, "ORB L: " + f_priceStr(orbLow),
             style=label.style_label_left, color=color.new(orbLowColor, 85), textcolor=orbLowColor, size=selectedLabelSize)
        if showMidline
            midLbl := label.new(bar_index + labelOffset, orbMid, "Mid: " + f_priceStr(orbMid),
                 style=label.style_label_left, color=color.new(midlineColor, 85), textcolor=midlineColor, size=selectedLabelSize)

    // Target projections on a bullish breakout
    if showTargetProjections and longTaken
        t1LongLine := line.new(startBar, t1Long, bar_index, t1Long, color=targetColor, style=line.style_dashed)
        t2LongLine := line.new(startBar, t2Long, bar_index, t2Long, color=targetColor, style=line.style_dashed)
        t3LongLine := line.new(startBar, t3Long, bar_index, t3Long, color=targetColor, style=line.style_dashed)
        if showOrbLabels
            t1LongLbl := label.new(bar_index + labelOffset, t1Long, "T1: " + f_priceStr(t1Long),
                 style=label.style_label_left, color=color.new(targetColor, 85), textcolor=targetColor, size=size.tiny)
            t2LongLbl := label.new(bar_index + labelOffset, t2Long, "T2: " + f_priceStr(t2Long),
                 style=label.style_label_left, color=color.new(targetColor, 85), textcolor=targetColor, size=size.tiny)
            t3LongLbl := label.new(bar_index + labelOffset, t3Long, "T3: " + f_priceStr(t3Long),
                 style=label.style_label_left, color=color.new(targetColor, 85), textcolor=targetColor, size=size.tiny)

    // Target projections on a bearish breakout
    if showTargetProjections and shortTaken
        t1ShortLine := line.new(startBar, t1Short, bar_index, t1Short, color=targetColor, style=line.style_dashed)
        t2ShortLine := line.new(startBar, t2Short, bar_index, t2Short, color=targetColor, style=line.style_dashed)
        t3ShortLine := line.new(startBar, t3Short, bar_index, t3Short, color=targetColor, style=line.style_dashed)
        if showOrbLabels
            t1ShortLbl := label.new(bar_index + labelOffset, t1Short, "T1: " + f_priceStr(t1Short),
                 style=label.style_label_left, color=color.new(targetColor, 85), textcolor=targetColor, size=size.tiny)
            t2ShortLbl := label.new(bar_index + labelOffset, t2Short, "T2: " + f_priceStr(t2Short),
                 style=label.style_label_left, color=color.new(targetColor, 85), textcolor=targetColor, size=size.tiny)
            t3ShortLbl := label.new(bar_index + labelOffset, t3Short, "T3: " + f_priceStr(t3Short),
                 style=label.style_label_left, color=color.new(targetColor, 85), textcolor=targetColor, size=size.tiny)

// NEW: dedicated ORB info panel, separate from the regime HUD below.
var table orbInfo = na

if showInfoPanel and validTF and barstate.islast and rangeSet
    table.delete(orbInfo)

    color boColor = firstBreakoutDir == "LONG" ? orbHighColor : firstBreakoutDir == "SHORT" ? orbLowColor : color.gray
    [bgColorTheme, textColorTheme, headerBgTheme] = f_themeColors()
    string selectedTableSize = f_tableSize(tableSizeInput)

    orbInfo := table.new(position.bottom_right, 2, 5, bgcolor=bgColorTheme, border_width=1, border_color=themeSelect == "Light" ? color.gray : color.new(color.gray, 50))

    table.cell(orbInfo, 0, 0, "ORB LEVELS", text_color=themeSelect == "Light" ? color.black : color.white, text_size=selectedTableSize, bgcolor=headerBgTheme)
    table.merge_cells(orbInfo, 0, 0, 1, 0)

    table.cell(orbInfo, 0, 1, "Range", text_color=textColorTheme, text_size=selectedTableSize)
    table.cell(orbInfo, 1, 1, f_priceStr(orbRangeWidth), text_color=textColorTheme, text_size=selectedTableSize)

    table.cell(orbInfo, 0, 2, "Quality", text_color=textColorTheme, text_size=selectedTableSize)
    table.cell(orbInfo, 1, 2, showRangeQuality ? rangeQuality : "-", text_color=rangeQualityColor, text_size=selectedTableSize)

    table.cell(orbInfo, 0, 3, "Range/ATR", text_color=textColorTheme, text_size=selectedTableSize)
    table.cell(orbInfo, 1, 3, str.tostring(rangeRatio, "#.##") + "x", text_color=textColorTheme, text_size=selectedTableSize)

    table.cell(orbInfo, 0, 4, "Breakout", text_color=textColorTheme, text_size=selectedTableSize)
    table.cell(orbInfo, 1, 4, firstBreakoutDir, text_color=boColor, text_size=selectedTableSize)

// Real-Time Regime HUD Dashboard (unchanged, top-right)
var table hud = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 30), border_width=1)
if barstate.islast
    table.clear(hud, 0, 0, 1, 2)
    string activeStateText = not useRegimeFilter ? (regimeState == 0 ? "SQUEEZE (filter OFF)" : regimeState == 1 ? "TRENDING (filter OFF)" : "RANGING (filter OFF)") :
                             regimeState == 0 ? "SQUEEZE (HIGH ORB EXPECTATION)" :
                             regimeState == 1 ? "TRENDING (ORB ENABLED)"          :
                             "RANGING (ORB DISABLED)"
    color activeStateColor = not useRegimeFilter ? color.gray :
                             regimeState == 0 ? color.yellow :
                             regimeState == 1 ? color.teal   :
                             color.orange

    table.cell(hud, 0, 0, "MARKET REGIME:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, activeStateText, bgcolor=activeStateColor, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 1, "ADX POWER:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(adxValue, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 2, "VOL COMPRESSION:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, isSqueezed ? "COILING" : "EXPANDED", bgcolor=isSqueezed ? color.new(color.yellow, 20) : color.new(color.green, 20), text_color=color.white, text_size=size.small)

// ==========================================
// --- INFORMATIONAL ALERTS (NEW) ---
// ==========================================
// Target-hit alerts, purely informational -- do not affect strategy
// execution (that's still governed by activeSL/activeTP + rrMultiple in
// the Exit Engine above, unchanged).
bool t1Hit = (longTaken and ta.crossover(high, t1Long)) or (shortTaken and ta.crossunder(low, t1Short))
bool t2Hit = (longTaken and ta.crossover(high, t2Long)) or (shortTaken and ta.crossunder(low, t2Short))

alertcondition(t1Hit, title="ORB Target 1 Hit", message="ORB Target 1 reached | {{ticker}} | {{interval}}")
alertcondition(t2Hit, title="ORB Target 2 Hit", message="ORB Target 2 reached | {{ticker}} | {{interval}}")
