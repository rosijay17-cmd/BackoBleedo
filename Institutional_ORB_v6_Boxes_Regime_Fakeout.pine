//@version=6
//@strategy_alert_message {{strategy.order.alert_message}} | {{ticker}} | {{interval}} | Fill: {{strategy.order.price}}

strategy("Institutional ORB v6 (Boxes + Regime + Fakeout)", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1)

// ==========================================
// --- INPUTS ---
// ==========================================
// 1. Dynamic Time Settings
orbStart       = input.string("0930", title="ORB Start Time (HHMM)", group="Dynamic Time Settings")
orbEnd         = input.string("1000", title="ORB End Time (HHMM)", group="Dynamic Time Settings")
tradingEnd     = input.string("1600", title="Trading Session End (HHMM)", group="Dynamic Time Settings")
timezone       = input.string("America/New_York", title="Session Timezone", group="Dynamic Time Settings")

// 2. Risk Settings
riskPct        = input.float(25.0, title="Stop Loss % of Range", minval=1.0, maxval=100.0, group="Risk Management", tooltip="Stop loss size as a percentage of the total range width")
rrMultiple     = input.float(5.0, title="Risk Reward Multiple", group="Risk Management")
forceClose     = input.bool(true, title="Force Close at Session End?", group="Risk Management")

// 3. Layer 1: Markov-Proxy Regime Switcher Settings
adxLength      = input.int(14, title="ADX Length", group="Layer 1: Regime Switcher")
adxThreshold   = input.int(25, title="ADX Trend Threshold", group="Layer 1: Regime Switcher")
bbSqueezeLen   = input.int(20, title="Squeeze BB Length", group="Layer 1: Regime Switcher")
bbSqueezeMult  = input.float(2.0, title="Squeeze BB Multiplier", group="Layer 1: Regime Switcher")
kcSqueezeMult  = input.float(1.5, title="Squeeze Keltner Multiplier", group="Layer 1: Regime Switcher")

// 4. Sub-Strategy B: Fakeout Breakout Filters
useVolumeFilter = input.bool(true, title="Enable Volume Confirmation?", group="Breakout Filters")
volLength       = input.int(20, title="Volume Average Length", group="Breakout Filters")
volMultiplier   = input.float(1.5, title="Volume Multiplier (x SMA)", group="Breakout Filters")

useWickFilter   = input.bool(true, title="Enable Rejection Wick Filter?", group="Breakout Filters")
maxWickPct      = input.float(35.0, title="Max Rejection Wick %", group="Breakout Filters")

useAtrPenetration  = input.bool(true, title="Enable ATR Penetration Filter?", group="Breakout Filters")
atrPenetrationMult = input.float(0.5, title="Min ATR Penetration Multiplier", group="Breakout Filters")

// 5. ORB Range Display (NEW -- the requested enhancement)
showOrbLabels    = input.bool(true, title="Show OR High/Low Labels", group="ORB Range Display")
showOrbRangeSize = input.bool(true, title="Show Range Size In Label", group="ORB Range Display")
showOrbMidline   = input.bool(true, title="Show OR Midpoint Line", group="ORB Range Display")
color orbBoxColor   = input.color(color.blue, title="OR Box Color", group="ORB Range Display")
color orbLabelColor = input.color(color.new(color.blue, 0), title="OR Label Text Color", group="ORB Range Display")
color orbMidColor   = input.color(color.new(color.gray, 40), title="OR Midpoint Line Color", group="ORB Range Display")

// 6. ORB Range Context (NEW -- ATR-normalized quality tag + target
// projections, re-implemented in spirit from the documented methodology
// of the public "ORB with Range Context" indicator by VishalSubandh:
// https://in.tradingview.com/script/kST1aBES-ORB-with-Range-Context/
rangeAtrLength         = input.int(14, title="Range Quality ATR Length", group="ORB Range Context")
narrowThreshold        = input.float(0.5, title="Narrow Threshold (x ATR)", minval=0.01, step=0.05, group="ORB Range Context", tooltip="Range below this multiple of ATR is classified NARROW.")
wideThreshold          = input.float(1.2, title="Wide Threshold (x ATR)", minval=0.01, step=0.05, group="ORB Range Context", tooltip="Range above this multiple of ATR is classified WIDE.")
showRangeQuality       = input.bool(true, title="Show Range Quality Tag", group="ORB Range Context")
showTargetProjections  = input.bool(true, title="Show Target Projections", group="ORB Range Context")
target1Mult            = input.float(1.0, title="Target 1 Multiple (x Range)", minval=0.1, step=0.1, group="ORB Range Context")
target2Mult            = input.float(1.5, title="Target 2 Multiple (x Range)", minval=0.1, step=0.1, group="ORB Range Context")
target3Mult            = input.float(2.0, title="Target 3 Multiple (x Range)", minval=0.1, step=0.1, group="ORB Range Context")
color qualityNarrowColor = input.color(color.orange, title="Narrow Tag Color", group="ORB Range Context")
color qualityNormalColor = input.color(color.blue,   title="Normal Tag Color", group="ORB Range Context")
color qualityWideColor   = input.color(color.purple, title="Wide Tag Color", group="ORB Range Context")
color target1Color = input.color(color.teal,   title="Target 1 Line Color", group="ORB Range Context")
color target2Color = input.color(color.orange, title="Target 2 Line Color", group="ORB Range Context")
color target3Color = input.color(color.red,    title="Target 3 Line Color", group="ORB Range Context")

// ==========================================
// --- DYNAMIC SESSION CONCATENATION ---
// ==========================================
string orbSession     = orbStart + "-" + orbEnd
string tradingSession = orbEnd + "-" + tradingEnd

// ==========================================
// --- LAYER 1: REGIME SWITCHER ENGINE ---
// ==========================================
// Volatility Compression (Squeeze Detection)
basisSqueeze = ta.sma(close, bbSqueezeLen)
devSqueeze   = bbSqueezeMult * ta.stdev(close, bbSqueezeLen)
upperBB      = basisSqueeze + devSqueeze
lowerBB      = basisSqueeze - devSqueeze

atrValSqueeze = ta.atr(bbSqueezeLen)
upperKC       = basisSqueeze + (atrValSqueeze * kcSqueezeMult)
lowerKC       = basisSqueeze - (atrValSqueeze * kcSqueezeMult)

bool isSqueezed = (upperBB < upperKC) and (lowerBB > lowerKC)

// Trend Momentum (ADX)
[diPlus, diMinus, adxValue] = ta.dmi(adxLength, adxLength)

// Regime Classification
int regimeState = 2
if isSqueezed
    regimeState := 0
else if adxValue >= adxThreshold
    regimeState := 1
else
    regimeState := 2

bool isRangingRegime = regimeState == 2

// ==========================================
// --- HELPERS (NEW) ---
// ==========================================
f_priceStr(float v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

// ==========================================
// --- RANGE TRACKING & VISUAL BOXES ---
// ==========================================
var float orbHigh = na
var float orbLow  = na
var bool rangeSet = false
var box orbBox    = na

// NEW: OR high/low price labels + midpoint reference line, anchored at
// the range's start bar so they read as a fixed tag on the box (like the
// reference image) instead of sliding across the chart every bar.
var label orbHighLabel = na
var label orbLowLabel  = na
var line  orbMidLine   = na

// NEW: target-projection lines/labels for the range-context enhancement
// below -- only one breakout's worth is kept on screen at a time (this
// strategy can, in principle, take a long breakout and later a short one
// on the same day with pyramiding=0's default reversal behavior), so a
// fresh breakout replaces the previous set rather than accumulating them.
var line  target1Line = na
var line  target2Line = na
var line  target3Line = na
var label target1Label = na
var label target2Label = na
var label target3Label = na

// NEW: ATR-normalized range-quality classification (Narrow / Normal /
// Wide), appended into the ORH label below. rangeAtr only depends on
// price history, not on orbHigh/orbLow, so it's safe to compute once per
// bar ahead of the session-tracking branches that use it.
float rangeAtr = ta.atr(rangeAtrLength)

f_qualityTag(float rangeWidth) =>
    float ratio = not na(rangeAtr) and rangeAtr > 0 and not na(rangeWidth) ? rangeWidth / rangeAtr : na
    string tag = na(ratio) ? "" : ratio < narrowThreshold ? "NARROW" : ratio > wideThreshold ? "WIDE" : "NORMAL"
    showRangeQuality and tag != "" ? "  [" + tag + " " + str.tostring(ratio, "#.##") + "x ATR]" : ""

// NEW: draws (replacing any prior set) the 1.0x/1.5x/2.0x target
// projection lines and labels from a breakout level. Visual only -- this
// strategy's actual take-profit below still uses rrMultiple, unchanged.
f_drawTargets(bool isLong, float breakoutLevel, float rangeWidth) =>
    float t1 = isLong ? breakoutLevel + rangeWidth * target1Mult : breakoutLevel - rangeWidth * target1Mult
    float t2 = isLong ? breakoutLevel + rangeWidth * target2Mult : breakoutLevel - rangeWidth * target2Mult
    float t3 = isLong ? breakoutLevel + rangeWidth * target3Mult : breakoutLevel - rangeWidth * target3Mult

    if not na(target1Line)
        line.delete(target1Line)
    if not na(target2Line)
        line.delete(target2Line)
    if not na(target3Line)
        line.delete(target3Line)
    if not na(target1Label)
        label.delete(target1Label)
    if not na(target2Label)
        label.delete(target2Label)
    if not na(target3Label)
        label.delete(target3Label)

    string dirTag = isLong ? "LONG" : "SHORT"
    target1Line := line.new(bar_index, t1, bar_index, t1, color=target1Color, width=1, style=line.style_dashed)
    target2Line := line.new(bar_index, t2, bar_index, t2, color=target2Color, width=1, style=line.style_dashed)
    target3Line := line.new(bar_index, t3, bar_index, t3, color=target3Color, width=1, style=line.style_dashed)
    target1Label := label.new(bar_index, t1, "T1 " + dirTag + " (" + f_priceStr(t1) + ")", style=label.style_label_left, color=color(na), textcolor=target1Color, size=size.small)
    target2Label := label.new(bar_index, t2, "T2 " + dirTag + " (" + f_priceStr(t2) + ")", style=label.style_label_left, color=color(na), textcolor=target2Color, size=size.small)
    target3Label := label.new(bar_index, t3, "T3 " + dirTag + " (" + f_priceStr(t3) + ")", style=label.style_label_left, color=color(na), textcolor=target3Color, size=size.small)

bool inOrbSession = not na(time(timeframe.period, orbSession, timezone))
bool isNewSession = inOrbSession and not inOrbSession[1]

// Create and update the visual box dynamically
if isNewSession
    orbHigh  := high
    orbLow   := low
    rangeSet := false

    // Create new box for the session
    orbBox := box.new(left=bar_index, top=high, right=bar_index, bottom=low,
                      bgcolor=color.new(orbBoxColor, 96),
                      border_color=color.new(orbBoxColor, 60),
                      border_width=2,
                      border_style=line.style_dashed)

    // NEW: (re)create the OR high/low labels and midpoint line for this
    // fresh session, deleting anything left over from the prior one.
    if not na(orbHighLabel)
        label.delete(orbHighLabel)
    if not na(orbLowLabel)
        label.delete(orbLowLabel)
    if not na(orbMidLine)
        line.delete(orbMidLine)

    // NEW: clear the prior day's target projections too.
    if not na(target1Line)
        line.delete(target1Line)
        target1Line := na
    if not na(target2Line)
        line.delete(target2Line)
        target2Line := na
    if not na(target3Line)
        line.delete(target3Line)
        target3Line := na
    if not na(target1Label)
        label.delete(target1Label)
        target1Label := na
    if not na(target2Label)
        label.delete(target2Label)
        target2Label := na
    if not na(target3Label)
        label.delete(target3Label)
        target3Label := na

    if showOrbLabels
        orbHighLabel := label.new(bar_index, high, "ORH " + f_priceStr(high),
                                   style=label.style_label_down, color=color(na),
                                   textcolor=orbLabelColor, size=size.small,
                                   textalign=text.align_left)
        orbLowLabel := label.new(bar_index, low, "ORL " + f_priceStr(low),
                                  style=label.style_label_up, color=color(na),
                                  textcolor=orbLabelColor, size=size.small,
                                  textalign=text.align_left)

    if showOrbMidline
        orbMidLine := line.new(bar_index, (high + low) / 2, bar_index, (high + low) / 2,
                                color=orbMidColor, width=1, style=line.style_dotted)

else if inOrbSession
    orbHigh := math.max(orbHigh, high)
    orbLow  := math.min(orbLow, low)

    // Dynamically expand the box edges in real-time
    if not na(orbBox)
        box.set_top(orbBox, orbHigh)
        box.set_bottom(orbBox, orbLow)
        box.set_right(orbBox, bar_index)

    // NEW: keep the OR high/low labels tracking the live range as it
    // forms, and keep the midpoint line's y centered between them.
    if showOrbLabels and not na(orbHighLabel)
        string highText = "ORH " + f_priceStr(orbHigh) + (showOrbRangeSize ? "  (" + f_priceStr(orbHigh - orbLow) + ")" : "") + f_qualityTag(orbHigh - orbLow)
        label.set_y(orbHighLabel, orbHigh)
        label.set_text(orbHighLabel, highText)
    if showOrbLabels and not na(orbLowLabel)
        label.set_y(orbLowLabel, orbLow)
        label.set_text(orbLowLabel, "ORL " + f_priceStr(orbLow))

    if showOrbMidline and not na(orbMidLine)
        line.set_y1(orbMidLine, (orbHigh + orbLow) / 2)
        line.set_y2(orbMidLine, (orbHigh + orbLow) / 2)
        line.set_x2(orbMidLine, bar_index)

else if not inOrbSession and inOrbSession[1]
    rangeSet := true

    // Finalize the right boundary of the box when the session ends
    if not na(orbBox)
        box.set_right(orbBox, bar_index[1])

    // NEW: lock the labels' final text once the range is set.
    if showOrbLabels and not na(orbHighLabel)
        string finalHighText = "ORH " + f_priceStr(orbHigh) + (showOrbRangeSize ? "  (" + f_priceStr(orbHigh - orbLow) + ")" : "") + f_qualityTag(orbHigh - orbLow)
        label.set_text(orbHighLabel, finalHighText)
    if showOrbLabels and not na(orbLowLabel)
        label.set_text(orbLowLabel, "ORL " + f_priceStr(orbLow))

// NEW: extend the midpoint line across the trading window after the
// range is finalized, so it reads as a persistent reference level for
// the rest of the day, matching the reference image.
if showOrbMidline and rangeSet and not na(orbMidLine)
    line.set_x2(orbMidLine, bar_index)

// NEW: extend today's target-projection lines forward as the session
// progresses, same idea as the midline above. inTradingWindow itself is
// declared later (Execution Engine section) so it's recomputed locally
// here rather than reordering the file -- it's a cheap time() check.
bool inTradingWindowForTargets = not na(time(timeframe.period, tradingSession, timezone))
if showTargetProjections and inTradingWindowForTargets
    if not na(target1Line)
        line.set_x2(target1Line, bar_index)
    if not na(target2Line)
        line.set_x2(target2Line, bar_index)
    if not na(target3Line)
        line.set_x2(target3Line, bar_index)

// Reset range lines on a daily basis
if ta.change(time("D")) != 0
    rangeSet := false
    orbHigh  := na
    orbLow   := na

// ==========================================
// --- FAKEOUT BREAKOUT FILTERS ---
// ==========================================
// 1. Volume Filter
volMa = ta.sma(volume, volLength)
bool isVolumeConfirmed = not useVolumeFilter or (volume > (volMa * volMultiplier))

// 2. Rejection Wick Filter
candleRange = high - low
upperWick   = high - math.max(open, close)
lowerWick   = math.min(open, close) - low

bool longWickOK  = not useWickFilter or (candleRange > 0 ? (upperWick / candleRange) * 100 <= maxWickPct : true)
bool shortWickOK = not useWickFilter or (candleRange > 0 ? (lowerWick / candleRange) * 100 <= maxWickPct : true)

// 3. ATR Penetration (Clearance distance)
atrVal = ta.atr(14)
bool longAtrPenetration  = not useAtrPenetration or ((close - orbHigh) >= (atrVal * atrPenetrationMult))
bool shortAtrPenetration = not useAtrPenetration or ((orbLow - close) >= (atrVal * atrPenetrationMult))

// Combined validation checks
bool isLongBreakoutValid  = isVolumeConfirmed and longWickOK and longAtrPenetration
bool isShortBreakoutValid = isVolumeConfirmed and shortWickOK and shortAtrPenetration

// ==========================================
// --- EXECUTION ENGINE ---
// ==========================================
bool inTradingWindow = not na(time(timeframe.period, tradingSession, timezone))

var bool longTaken  = false
var bool shortTaken = false

if ta.change(time("D")) != 0
    longTaken  := false
    shortTaken := false

// Trigger breakouts on close confirmation outside the range boundaries
bool rawLongTrigger  = rangeSet and inTradingWindow and not longTaken and ta.crossover(close, orbHigh)
bool rawShortTrigger = rangeSet and inTradingWindow and not shortTaken and ta.crossunder(close, orbLow)

// ORB Entries are strictly blocked during Ranging Regimes (isRangingRegime == false)
bool longTrigger  = rawLongTrigger and not isRangingRegime and isLongBreakoutValid
bool shortTrigger = rawShortTrigger and not isRangingRegime and isShortBreakoutValid

var float activeSL = na
var float activeTP = na

float slDistance = (orbHigh - orbLow) * (riskPct / 100.0)

// 1. Long Entry
if longTrigger
    longTaken := true
    activeSL  := close - slDistance
    activeTP  := close + (slDistance * rrMultiple)
    strategy.entry("Long", strategy.long, comment="ORB LONG")
    if showTargetProjections
        f_drawTargets(true, orbHigh, orbHigh - orbLow)

// 2. Short Entry
if shortTrigger
    shortTaken := true
    activeSL   := close + slDistance
    activeTP   := close - (slDistance * rrMultiple)
    strategy.entry("Short", strategy.short, comment="ORB SHORT")
    if showTargetProjections
        f_drawTargets(false, orbLow, orbHigh - orbLow)

// ==========================================
// --- EXIT ENGINE ---
// ==========================================
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP, comment="SL/TP Exit")

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP, comment="SL/TP Exit")

// End of trading window force-close
bool sessionJustEnded = not inTradingWindow and inTradingWindow[1]
if forceClose and sessionJustEnded and strategy.position_size != 0
    strategy.close_all(comment="Session Ended - Force Close")

// ==========================================
// --- VISUALIZATIONS & HUD ---
// ==========================================
// Shapes representing verified breakouts
plotshape(longTrigger, title="ORB Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="ORB BUY")
plotshape(shortTrigger, title="ORB Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="ORB SELL")

// Real-Time HUD Dashboard
var table hud = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 30), border_width=1)
if barstate.islast
    table.clear(hud, 0, 0, 1, 2)
    string activeStateText = regimeState == 0 ? "SQUEEZE (HIGH ORB EXPECTATION)" :
                             regimeState == 1 ? "TRENDING (ORB ENABLED)"          :
                             "RANGING (ORB DISABLED)"
    color activeStateColor = regimeState == 0 ? color.yellow :
                             regimeState == 1 ? color.teal   :
                             color.orange

    table.cell(hud, 0, 0, "MARKET REGIME:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, activeStateText, bgcolor=activeStateColor, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 1, "ADX POWER:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(adxValue, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 2, "VOL COMPRESSION:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, isSqueezed ? "COILING" : "EXPANDED", bgcolor=isSqueezed ? color.new(color.yellow, 20) : color.new(color.green, 20), text_color=color.white, text_size=size.small)
