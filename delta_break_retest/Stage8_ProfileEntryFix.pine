//@version=6
strategy(
     title = "Delta Break & Retest - Stage 8.0.2 Profile + Entry Fix",
     shorttitle = "DBR S8.0.2",
     overlay = true,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 300,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     calc_on_order_fills = false,
     calc_on_every_tick = true,
     process_orders_on_close = true,
     initial_capital = 100000,
     margin_long = 3,
     margin_short = 3
)

// ============================================================================
// DELTA BREAK & RETEST - STAGE 8
// ----------------------------------------------------------------------------
// RUN ON MNQ 5m.
//
// 15m = break-context / POI event.
// 4H  = directional bias.
// 1H  = active trend quality.
// 5m  = retest + reclaim + execution.
//
// ENTRY SEQUENCE:
// BREAK
// -> RETEST FROM CORRECT SIDE
// -> PRESSURE ROTATION
// -> RECLAIM
// -> 4H + 1H AGREEMENT
// -> ENTRY
//
// IMPORTANT:
// Pine does not expose exchange-native bid/ask aggressor delta here.
// All delta/pressure values below are estimated from OHLCV candle pressure.
// ============================================================================


// ============================================================================
// HELPERS
// ============================================================================

f_clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

f_delta(float o, float h, float l, float c, float v) =>
    float safeRange = math.max(h - l, syminfo.mintick)
    float pressure = f_clamp((c - o) / safeRange, -1.0, 1.0)
    v * pressure

f_typeCodeName(int code) =>
    code == 1 ? "Delta POC" :
     code == 2 ? "Delta Extreme +" :
     code == 3 ? "Delta Extreme -" :
     code == 4 ? "Delta Flip" :
     code == 5 ? "Absorption Node" :
     "?"

float barDelta = f_delta(open, high, low, close, nz(volume, 0.0))
float atr5m = math.max(nz(ta.atr(14), ta.tr(true)), syminfo.mintick)


// ============================================================================
// 01 - 15m BREAK CONTEXT INPUTS
// ============================================================================

string G_BREAK = "01 - 15m Break Context"

string breakContextTimeframeInput = input.timeframe(
     "15",
