     minval = 10,
     maxval = 120,
     group = G_BREAK
)

float poiAtrMultInput = input.float(
     0.25,
     "POI Zone Half-Width (x ATR)",
     minval = 0.05,
     maxval = 2.0,
     step = 0.05,
     group = G_BREAK
)

int minEndedSessionBarsInput = input.int(
     10,
     "Minimum Bars To Finalize Session",
     minval = 3,
     maxval = 100,
     group = G_BREAK
)

bool showAbsorptionInput = input.bool(
     true,
     "Track Absorption Node",
     group = G_BREAK
)

float minBreakAtrMultInput = input.float(
