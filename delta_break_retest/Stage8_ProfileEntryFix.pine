     true,
     "Show Retest Funnel Diagnostics",
     tooltip = "Second table: counts how many break events reach each stage of the retest/trigger chain, and which gate blocks a RETESTED bar most often. Use this to find where signals are dying without Strategy Tester access.",
     group = G_DASH
